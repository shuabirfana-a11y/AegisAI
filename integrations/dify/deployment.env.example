# Deployment settings. Bootstrap generates private runtime .env secrets.
# AEGIS_ASSET_TOKEN belongs in Dify's app environment variable of type secret.
# It is NOT a Docker deployment secret and is never embedded in the DSL.
DIFY_VERSION=1.17.1
DIFY_COMMIT=8387590ace4a094de812b7847fc6a4c3a27cd52b
DIFY_CONSOLE_URL=http://127.0.0.1:8088
DIFY_API_URL=http://127.0.0.1:8088/v1
DIFY_APP_API_KEY=
DIFY_TOOL_APP_API_KEY=
AEGIS_API_URL=http://127.0.0.1:8000/api/v1
AEGIS_BACKEND_URL=http://127.0.0.1:8000
AEGIS_ASSET_TOKEN=
# This user identifies workflow runs; it cannot change the backend asset owner.
DIFY_END_USER=aegis-local-phase9
