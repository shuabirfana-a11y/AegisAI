                    "type": "string",
                    "nullable": true
                  },
                  "days": {
                    "default": null,
                    "title": "Days",
                    "maximum": 365,
                    "minimum": 1,
                    "type": "integer",
                    "nullable": true
                  },
                  "limit": {
                    "default": 20,
                    "maximum": 100,
                    "minimum": 1,
                    "title": "Limit",
                    "type": "integer"
                  }
                },
                "title": "SearchInput",
                "type": "object"
              }
