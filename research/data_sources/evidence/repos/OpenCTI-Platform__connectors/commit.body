{"sha":"4cc0ea22561541dddd22c32dc83347f5a376c909","node_id":"C_kwDOC3sPdNoAKDRjYzBlYTIyNTYxNTQxZGRkZDIyYzMyZGM4MzM0N2Y1YTM3NmM5MDk","commit":{"author":{"name":"Gamezilla19","email":"77228864+gamezilla19@users.noreply.github.com","date":"2026-10-02T14:05:13Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-10-02T14:05:13Z"},"message":"fix(dark-web-informer): only ingest new data using connector state (#7824) (#7825)","tree":{"sha":"42789fafa867168b8cd17347f717364ea525b4da","url":"https://api.github.com/repos/OpenCTI-Platform/connectors/git/trees/42789fafa867168b8cd17347f717364ea525b4da"},"url":"https://api.github.com/repos/OpenCTI-Platform/connectors/git/commits/4cc0ea22561541dddd22c32dc83347f5a376c909","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqv7ooCRC1aQ7uu5UhlAAAqq4QAAZtBtLUwqjM7Tu2QWUDvQoW\n4A2ayLyWvKIhZCFs0JPU9/yrEUSmegiCIBjHKZGolH4Jv9XlPwxFQiQhL995Ecle\nBJnyMN1e5Ih/6jifHC0eyYqaoQEqrTwQ82jLGbKO1SWKWHBIse2M0rzHdHeiJmGN\n/BNZDuWHvrxzOBG/vUufJRNNLf5opfD6uY3fvQhsJxfcI41yVwiw77oOm35HUv6m\nuIAZ0H9icUfD2+hbg4ddpMREcqsX57Os45sjr3PX+psbGWDbFfGPX1HPxjLyrZG2\nAnE31D+tpdzc66OvrNOXZ7jtxene1neTZT0bpznGr3dNn04VAH8r/OgiFVllgkhY\nmPthFTWNGdQSqNVq/ZniVfCtSWRZAmQHf9x7AqkNA9H7pj5stsPoiyBsWuRK1TEO\nGCRJEY6YnGgTn+AFchsFxoMMAD9uo1MLIcQsv0WXTAm27ZvMScyYNuL/8agn98MS\ny4Y2veSN1UtqCI/WrNpnHt+QdAJTr4JPJaigmi01i1oAQU9rJacemZdSWscoUdgr\npkQ6xnMtliOpJdGrnZj7CkNv1d55qMcn/kvkCICi+DBOUO87/54tIWninFlMpRWB\nZCIsfG3MI/aWr0lqP5MO7Tsk8s1PMOWFicZfQ5oieoNCB9MMjR82S8cDEIr7BVeD\nQ+oMCx5OjypJhLhT2h2Y\n=4hwg\n-----END PGP SIGNATURE-----\n","payload":"tree 42789fafa867168b8cd17347f717364ea525b4da\nparent 629949102ab77d35a02eb1bda2543f517d72584f\nauthor Gamezilla19 <77228864+gamezilla19@users.noreply.github.com> 1790949913 +0000\ncommitter GitHub <noreply@github.com> 1790949913 +0000\n\nfix(dark-web-informer): only ingest new data using connector state (#7824) (#7825)","verified_at":"2026-10-02T14:05:29Z"}},"url":"https://api.github.com/repos/OpenCTI-Platform/connectors/commits/4cc0ea22561541dddd22c32dc83347f5a376c909","html_url":"https://github.com/OpenCTI-Platform/connectors/commit/4cc0ea22561541dddd22c32dc83347f5a376c909","comments_url":"https://api.github.com/repos/OpenCTI-Platform/connectors/commits/4cc0ea22561541dddd22c32dc83347f5a376c909/comments","author":{"login":"gamezilla19","id":77228864,"node_id":"MDQ6VXNlcjc3MjI4ODY0","avatar_url":"https://avatars.githubusercontent.com/u/77228864?v=4","gravatar_id":"","url":"https://api.github.com/users/gamezilla19","html_url":"https://github.com/gamezilla19","followers_url":"https://api.github.com/users/gamezilla19/followers","following_url":"https://api.github.com/users/gamezilla19/following{/other_user}","gists_url":"https://api.github.com/users/gamezilla19/gists{/gist_id}","starred_url":"https://api.github.com/users/gamezilla19/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gamezilla19/subscriptions","organizations_url":"https://api.github.com/users/gamezilla19/orgs","repos_url":"https://api.github.com/users/gamezilla19/repos","events_url":"https://api.github.com/users/gamezilla19/events{/privacy}","received_events_url":"https://api.github.com/users/gamezilla19/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"629949102ab77d35a02eb1bda2543f517d72584f","url":"https://api.github.com/repos/OpenCTI-Platform/connectors/commits/629949102ab77d35a02eb1bda2543f517d72584f","html_url":"https://github.com/OpenCTI-Platform/connectors/commit/629949102ab77d35a02eb1bda2543f517d72584f"}],"stats":{"total":583,"additions":550,"deletions":33},"files":[{"sha":"7e365afea23c25c88934e92d68384d350a5632b1","filename":"external-import/dark-web-informer/README.md","status":"modified","additions":57,"deletions":9,"changes":66,"blob_url":"https://github.com/OpenCTI-Platform/connectors/blob/4cc0ea22561541dddd22c32dc83347f5a376c909/external-import%2Fdark-web-informer%2FREADME.md","raw_url":"https://github.com/OpenCTI-Platform/connectors/raw/4cc0ea22561541dddd22c32dc83347f5a376c909/external-import%2Fdark-web-informer%2FREADME.md","contents_url":"https://api.github.com/repos/OpenCTI-Platform/connectors/contents/external-import%2Fdark-web-informer%2FREADME.md?ref=4cc0ea22561541dddd22c32dc83347f5a376c909","patch":"@@ -1,5 +1,31 @@\n # OpenCTI Dark Web Informer Connector\n \n+| Status | Date | Comment |\n+|--------|------|---------|\n+| Community | -    | -       |\n+\n+The Dark Web Informer connector ingests Dark Web Informer intelligence into OpenCTI from its prebuilt STIX 2.1 bundles.\n+\n+## Table of Contents\n+\n+- [OpenCTI Dark Web Informer Connector](#opencti-dark-web-informer-connector)\n+  - [Table of Contents](#table-of-contents)\n+  - [Introduction](#introduction)\n+  - [Installation](#installation)\n+    - [Requirements](#requirements)\n+  - [Configuration variables](#configuration-variables)\n+    - [OpenCTI environment variables](#opencti-environment-variables)\n+    - [Base connector environment variables](#base-connector-environment-variables)\n+    - [Connector extra parameters environment variables](#connector-extra-parameters-environment-variables)\n+  - [Deployment](#deployment)\n+    - [Docker Deployment](#docker-deployment)\n+    - [Manual Deployment](#manual-deployment)\n+  - [Usage](#usage)\n+  - [Behavior](#behavior)\n+  - [Debugging](#debugging)\n+  - [Additional information](#additional-information)\n+  - [Development](#development)\n+\n ## Introduction\n \n Dark Web Informer monitors dark web forums, ransomware leak sites, and cybercrime\n@@ -13,27 +39,29 @@ author and a TLP marking — attached to the ingested objects that do not alread\n declare their own. Because the bundles are already valid STIX 2.1 carrying\n deterministic IDs, OpenCTI deduplicates and merges on re-ingest.\n \n-## Requirements\n+## Installation\n+\n+### Requirements\n \n - OpenCTI Platform >= 6.8.12\n - Python 3.11 or 3.12\n - A Dark Web Informer API key (`X-API-Key`)\n \n-## Configuration\n+## Configuration variables\n \n Configuration is provided via environment variables, `config.yml`, or\n `docker-compose.yml`. The connector uses `connectors-sdk` Pydantic settings.\n \n Find all the configuration variables available here: [Connector Configurations](./__metadata__/CONNECTOR_CONFIG_DOC.md)\n \n-### OpenCTI\n+### OpenCTI environment variables\n \n | Parameter | Docker env var  | Mandatory | Description                                 |\n |-----------|-----------------|-----------|---------------------------------------------|\n | URL       | `OPENCTI_URL`   | Yes       | URL of the OpenCTI platform.                |\n | Token     | `OPENCTI_TOKEN` | Yes       | Token of a user with the right permissions. |\n \n-### Connector\n+### Base connector environment variables\n \n | Parameter       | Docker env var              | Default            | Description                                                                                                                                                                                                                                                              |\n |-----------------|-----------------------------|--------------------|--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------|\n@@ -43,7 +71,7 @@ Find all the configuration variables available here: [Connector Configurations](\n | Log Level       | `CONNECTOR_LOG_LEVEL`       | error              | debug, info, warn, error.                                                                                                                                                                                                                                                |\n | Duration Period | `CONNECTOR_DURATION_PERIOD` | PT6H               | ISO-8601 period between runs. Dark Web Informer regenerates its STIX exports every 30 minutes, so polling faster than hourly provides no benefit; hourly or slower is recommended. OpenCTI deduplicates on deterministic STIX IDs, so overlapping runs merge rather than duplicate. |\n \n-### Dark Web Informer\n+### Connector extra parameters environment variables\n \n | Parameter            | Docker env var                        | Default                          | Description                                                                                  |\n |----------------------|---------------------------------------|----------------------------------|----------------------------------------------------------------------------------------------|\n@@ -56,13 +84,15 @@ Find all the configuration variables available here: [Connector Configurations](\n \n ## Deployment\n \n-### Docker\n+### Docker Deployment\n+\n+Configure the connector in `docker-compose.yml`, then build and start it:\n \n ```shell\n docker compose up -d --build\n ```\n \n-### Manual\n+### Manual Deployment\n \n ```shell\n cd src\n@@ -71,6 +101,14 @@ cp ../config.yml.sample ../config.yml   # then edit\n python main.py\n ```\n \n+## Usage\n+\n+The connector runs automatically at the interval defined by `CONNECTOR_DURATION_PERIOD`. To force an immediate run:\n+\n+**Data Management → Ingestion → Connectors**\n+\n+Find the connector and click the refresh button to reset the state and trigger a new data fetch.\n+\n ## Behavior\n \n The connector runs every `duration_period`. On each run it fetches, for each\n@@ -92,8 +130,8 @@ The bundles are forwarded with `helper.send_stix2_bundle`, using\n `cleanup_inconsistent_bundle=True` so a dangling reference in a third-party bundle\n drops the offending object instead of failing the whole import. Dark Web Informer's\n bundles already include its own identity and a copyright marking, and use\n-deterministic STIX IDs, so repeated full-snapshot ingestion merges rather than\n-duplicates objects in the platform.\n+deterministic STIX IDs, so objects ingested again merge rather than duplicate in\n+the platform.\n \n **Provenance.** No STIX is rewritten on the connector side, but a \"Dark Web\n Informer\" organization author and a `tlp_level` marking are prepended to each\n@@ -105,6 +143,16 @@ SCOs cannot carry `created_by_ref`.\n A work is only registered once a non-empty bundle is available, so a run that\n finds nothing does not leave an empty job in OpenCTI.\n \n+## Debugging\n+\n+Enable verbose logging:\n+\n+```env\n+CONNECTOR_LOG_LEVEL=debug\n+```\n+\n+## Additional information\n+\n **Authentication.** Each request carries `X-API-Key` and a single-use `X-Nonce`\n (`<10-digit epoch>:<>=6 chars [A-Za-z0-9_-]>`, 120 s window). No client-side HMAC.\n "},{"sha":"3381feff5ad4db402496b139bf47a097236b080f","filename":"external-import/dark-web-informer/src/connector/__init__.py","status":"modified","additions":2,"deletions":1,"changes":3,"blob_url":"https://github.com/OpenCTI-Platform/connectors/blob/4cc0ea22561541dddd22c32dc83347f5a376c909/external-import%2Fdark-web-informer%2Fsrc%2Fconnector%2F__init__.py","raw_url":"https://github.com/OpenCTI-Platform/connectors/raw/4cc0ea22561541dddd22c32dc83347f5a376c909/external-import%2Fdark-web-informer%2Fsrc%2Fconnector%2F__init__.py","contents_url":"https://api.github.com/repos/OpenCTI-Platform/connectors/contents/external-import%2Fdark-web-informer%2Fsrc%2Fconnector%2F__init__.py?ref=4cc0ea22561541dddd22c32dc83347f5a376c909","patch":"@@ -2,5 +2,6 @@\n \n from connector.connector import DarkWebInformerConnector\n from connector.settings import ConnectorSettings\n+from connector.state import ConnectorState\n \n-__all__ = [\"DarkWebInformerConnector\", \"ConnectorSettings\"]\n+__all__ = [\"DarkWebInformerConnector\", \"ConnectorSettings\", \"ConnectorState\"]"},{"sha":"dbe8a70b6786d5662fbb83f4c55b0c6cb9992893","filename":"external-import/dark-web-informer/src/connector/connector.py","status":"modified","additions":199,"deletions":22,"changes":221,"blob_url":"https://github.com/OpenCTI-Platform/connectors/blob/4cc0ea22561541dddd22c32dc83347f5a376c909/external-import%2Fdark-web-informer%2Fsrc%2Fconnector%2Fconnector.py","raw_url":"https://github.com/OpenCTI-Platform/connectors/raw/4cc0ea22561541dddd22c32dc83347f5a376c909/external-import%2Fdark-web-informer%2Fsrc%2Fconnector%2Fconnector.py","contents_url":"https://api.github.com/repos/OpenCTI-Platform/connectors/contents/external-import%2Fdark-web-informer%2Fsrc%2Fconnector%2Fconnector.py?ref=4cc0ea22561541dddd22c32dc83347f5a376c909","patch":"@@ -6,26 +6,33 @@\n intrusion-sets, reports and their relationships), so no conversion layer is\n needed. Deduplication is handled by OpenCTI via the deterministic STIX IDs.\n \n+DWI only publishes full snapshots, so the connector keeps a per-source cursor\n+(the most recent ``modified``/``created`` timestamp seen) in its state and, on\n+the next runs, only forwards the objects changed since then, plus the objects\n+they reference so the bundle stays consistent.\n+\n The only objects the connector adds are provenance ones: a \"Dark Web Informer\"\n organization author and a TLP marking, attached to the ingested objects that do\n-not already carry their own. DWI's own values always win.\n+not already carry their own. DWI's own values always win, and when a bundle\n+already carries DWI's author identity, that identity is reused instead of adding\n+a second one.\n \"\"\"\n \n from __future__ import annotations\n \n import json\n+from collections import Counter\n from datetime import datetime, timezone\n \n from connector.settings import ConnectorSettings\n+from connector.state import ConnectorState\n from connectors_sdk.models.organization_author import OrganizationAuthor\n from connectors_sdk.models.tlp_marking import TLPMarking\n from dark_web_informer_client import DarkWebInformerClient\n from pycti import OpenCTIConnectorHelper\n \n __all__ = [\"DarkWebInformerConnector\"]\n \n-_STATE_LAST_RUN = \"last_run\"\n-\n # STIX Cyber Observables carry their author under an OpenCTI custom property,\n # since created_by_ref is not a valid SCO field in STIX 2.1.\n _SCO_TYPES = frozenset(\n@@ -66,6 +73,38 @@\n _UNATTRIBUTABLE_TYPES = frozenset({\"marking-definition\", \"language-content\"})\n \n \n+def _parse_timestamp(value: object) -> datetime | None:\n+    \"\"\"Parse a STIX timestamp, tolerating any sub-second precision.\"\"\"\n+    if not isinstance(value, str):\n+        return None\n+    try:\n+        parsed = datetime.fromisoformat(value.replace(\"Z\", \"+00:00\"))\n+    except ValueError:\n+        return None\n+    if parsed.tzinfo is None:\n+        parsed = parsed.replace(tzinfo=timezone.utc)\n+    return parsed\n+\n+\n+def _object_timestamp(obj: dict) -> datetime | None:\n+    \"\"\"Return when an object last changed, or None if it carries no timestamp.\n+\n+    SCOs have neither ``modified`` nor ``created`` in STIX 2.1.\n+    \"\"\"\n+    return _parse_timestamp(obj.get(\"modified\")) or _parse_timestamp(obj.get(\"created\"))\n+\n+\n+def _referenced_ids(obj: dict) -> set[str]:\n+    \"\"\"Return the STIX IDs an object points to through its *_ref(s) properties.\"\"\"\n+    refs: set[str] = set()\n+    for key, value in obj.items():\n+        if key.endswith(\"_ref\") and isinstance(value, str):\n+            refs.add(value)\n+        elif key.endswith(\"_refs\") and isinstance(value, list):\n+            refs.update(v for v in value if isinstance(v, str))\n+    return refs\n+\n+\n class DarkWebInformerConnector:\n     \"\"\"External-import connector ingesting Dark Web Informer STIX bundles.\"\"\"\n \n@@ -74,6 +113,7 @@ def __init__(\n     ) -> None:\n         self.helper = helper\n         self.settings = settings\n+        self.state = self._load_state()\n         config = settings.dark_web_informer\n \n         self.client = DarkWebInformerClient(\n@@ -103,15 +143,94 @@ def _bundle_objects(bundle: dict) -> list | None:\n             return None\n         return bundle.get(\"objects\") or None\n \n-    def _with_provenance(self, bundle: dict, objects: list) -> dict:\n+    @staticmethod\n+    def _bundle_cursor(objects: list) -> datetime | None:\n+        \"\"\"Return the most recent object timestamp of a bundle.\"\"\"\n+        timestamps = [\n+            ts\n+            for obj in objects\n+            if isinstance(obj, dict) and (ts := _object_timestamp(obj)) is not None\n+        ]\n+        return max(timestamps, default=None)\n+\n+    @staticmethod\n+    def _changed_since(objects: list, cursor: datetime) -> list:\n+        \"\"\"Return the objects changed after ``cursor``, with what they reference.\n+\n+        Objects without a timestamp (observables, markings...) are only kept\n+        when a changed object references them, directly or transitively.\n+        \"\"\"\n+        by_id = {\n+            obj[\"id\"]: obj\n+            for obj in objects\n+            if isinstance(obj, dict) and isinstance(obj.get(\"id\"), str)\n+        }\n+        kept: set[str] = set()\n+        pending = [\n+            oid\n+            for oid, obj in by_id.items()\n+            if (ts := _object_timestamp(obj)) is not None and ts > cursor\n+        ]\n+        while pending:\n+            oid = pending.pop()\n+            if oid in kept or oid not in by_id:\n+                continue\n+            kept.add(oid)\n+            pending.extend(_referenced_ids(by_id[oid]) - kept)\n+\n+        # Preserve DWI's original ordering.\n+        return [\n+            obj for obj in objects if isinstance(obj, dict) and obj.get(\"id\") in kept\n+        ]\n+\n+    @staticmethod\n+    def _bundle_author(objects: list) -> dict | None:\n+        \"\"\"Return the identity DWI declares as author in its bundle, if any.\n+\n+        This is the identity most referenced through created_by_ref (or\n+        x_opencti_created_by_ref for observables) among the bundle's objects.\n+        \"\"\"\n+        identities = {\n+            obj[\"id\"]: obj\n+            for obj in objects\n+            if isinstance(obj, dict) and obj.get(\"type\") == \"identity\"\n+        }\n+        refs = Counter(\n+            ref\n+            for obj in objects\n+            if isinstance(obj, dict)\n+            and (\n+                ref := obj.get(\"created_by_ref\") or obj.get(\"x_opencti_created_by_ref\")\n+            )\n+            in identities\n+        )\n+        if not refs:\n+            return None\n+        return identities[refs.most_common(1)[0][0]]\n+\n+    def _with_provenance(\n+        self, bundle: dict, objects: list, dwi_author: dict | None = None\n+    ) -> dict:\n         \"\"\"Return the bundle with the author and TLP marking attached.\n \n         DWI's objects are otherwise untouched: an object that already declares\n-        its own author or markings keeps them.\n+        its own author or markings keeps them. When the bundle already carries\n+        DWI's own author identity, it is reused for the objects without one, so\n+        the ingested data only ever has a single creator.\n+\n+        ``dwi_author`` is the author resolved on the full snapshot: a filtered\n+        bundle may no longer contain DWI's identity, which is then added back.\n         \"\"\"\n-        author_id = self.author_stix[\"id\"]\n+        dwi_author = dwi_author or self._bundle_author(objects)\n+        author_id = (dwi_author or self.author_stix)[\"id\"]\n         marking_id = self.marking_stix[\"id\"]\n-        attributed: list = [self.author_stix, self.marking_stix]\n+        attributed: list = [self.marking_stix]\n+        if dwi_author is None:\n+            attributed.insert(0, self.author_stix)\n+        elif not any(\n+            isinstance(obj, dict) and obj.get(\"id\") == author_id for obj in objects\n+        ):\n+            attributed.insert(0, dwi_author)\n \n         for obj in objects:\n             if not isinstance(obj, dict):\n@@ -136,7 +255,9 @@ def _with_provenance(self, bundle: dict, objects: list) -> dict:\n \n         return {**bundle, \"objects\": attributed}\n \n-    def _send_bundle(self, bundle: dict, work_id: str) -> int:\n+    def _send_bundle(\n+        self, bundle: dict, work_id: str, dwi_author: dict | None = None\n+    ) -> int:\n         \"\"\"Forward a native DWI STIX bundle to OpenCTI.\n \n         Returns the number of DWI objects sent (0 if empty/invalid), excluding\n@@ -148,46 +269,102 @@ def _send_bundle(self, bundle: dict, work_id: str) -> int:\n         # DWI bundles are third-party payloads we do not rewrite, so let OpenCTI\n         # drop dangling references instead of failing the whole bundle.\n         self.helper.send_stix2_bundle(\n-            json.dumps(self._with_provenance(bundle, objects)),\n+            json.dumps(self._with_provenance(bundle, objects, dwi_author)),\n             work_id=work_id,\n             cleanup_inconsistent_bundle=True,\n         )\n         return len(objects)\n \n+    def _load_state(self) -> ConnectorState:\n+        \"\"\"Load the persisted state into a fresh ConnectorState.\n+\n+        A new instance is built on every run: `load()` only overwrites the\n+        fields returned by OpenCTI, so reusing an instance would keep stale\n+        cursors after the state is reset from the platform.\n+        \"\"\"\n+        state = ConnectorState()\n+        state.inject_dependencies(self.helper)\n+        state.load()\n+        return state\n+\n     def _fetch_bundle(self, source: str) -> dict:\n         if self.use_preview:\n             return self.client.get_stix_preview(source=source, limit=self.preview_limit)\n         return self.client.get_stix_bundle(source)\n \n     def process_message(self) -> None:\n         now = datetime.now(timezone.utc)\n+        self.state = self._load_state()\n+        cursors: dict[str, datetime] = dict(self.state.cursors or {})\n         self.helper.connector_logger.info(\n-            \"Starting Dark Web Informer run\", {\"sources\": self.sources}\n+            \"Starting Dark Web Informer run\",\n+            {\n+                \"sources\": self.sources,\n+                \"last_run\": str(self.state.last_run),\n+                \"cursors\": {k: v.isoformat() for k, v in cursors.items()},\n+            },\n         )\n         work_id: str | None = None\n         try:\n             total = 0\n             for source in self.sources:\n                 bundle = self._fetch_bundle(source)\n-                if not self._bundle_objects(bundle):\n+                objects = self._bundle_objects(bundle)\n+                if not objects:\n                     self.helper.connector_logger.info(\n                         \"Empty bundle, nothing to ingest\", {\"source\": source}\n                     )\n                     continue\n \n-                # Register the work lazily, so a run that finds no data anywhere\n-                # does not leave an empty job behind in OpenCTI.\n-                if work_id is None:\n-                    work_id = self.helper.api.work.initiate_work(\n-                        self.helper.connect_id, \"Dark Web Informer run\"\n+                bundle_cursor = self._bundle_cursor(objects)\n+                if bundle_cursor is not None:\n+                    bundle_cursor = min(bundle_cursor, now)\n+                # Resolved on the full snapshot: once filtered, the bundle may\n+                # no longer reference DWI's author identity.\n+                dwi_author = self._bundle_author(objects)\n+                previous_cursor = cursors.get(source)\n+                if previous_cursor is not None:\n+                    objects = self._changed_since(objects, previous_cursor)\n+                    self.helper.connector_logger.info(\n+                        \"Filtered bundle on previous cursor\",\n+                        {\n+                            \"source\": source,\n+                            \"cursor\": previous_cursor.isoformat(),\n+                            \"objects\": len(objects),\n+                        },\n                     )\n-                count = self._send_bundle(bundle, work_id)\n-                self.helper.connector_logger.info(\n-                    \"Sent bundle\", {\"source\": source, \"objects\": count}\n-                )\n-                total += count\n \n-            self.helper.set_state({_STATE_LAST_RUN: now.isoformat()})\n+                if objects:\n+                    # Register the work lazily, so a run that finds no data\n+                    # anywhere does not leave an empty job behind in OpenCTI.\n+                    if work_id is None:\n+                        work_id = self.helper.api.work.initiate_work(\n+                            self.helper.connect_id, \"Dark Web Informer run\"\n+                        )\n+                    count = self._send_bundle(\n+                        {**bundle, \"objects\": objects}, work_id, dwi_author\n+                    )\n+                    self.helper.connector_logger.info(\n+                        \"Sent bundle\", {\"source\": source, \"objects\": count}\n+                    )\n+                    total += count\n+                else:\n+                    self.helper.connector_logger.info(\n+                        \"No new objects since last run\", {\"source\": source}\n+                    )\n+\n+                # Persist each source's cursor as soon as it is ingested, so a\n+                # failure on a later source does not resend this one.\n+                if bundle_cursor is not None and (\n+                    previous_cursor is None or bundle_cursor > previous_cursor\n+                ):\n+                    cursors[source] = bundle_cursor\n+                    self.state.cursors = cursors\n+                    self.state.save()\n+\n+            self.state.cursors = cursors\n+            self.state.last_run = now\n+            self.state.save()\n             if work_id is None:\n                 self.helper.connector_logger.info(\"No new data to ingest\")\n             else:"},{"sha":"2a66274de9b88469035448ec9f31c483ba1449d6","filename":"external-import/dark-web-informer/src/connector/state.py","status":"added","additions":26,"deletions":0,"changes":26,"blob_url":"https://github.com/OpenCTI-Platform/connectors/blob/4cc0ea22561541dddd22c32dc83347f5a376c909/external-import%2Fdark-web-informer%2Fsrc%2Fconnector%2Fstate.py","raw_url":"https://github.com/OpenCTI-Platform/connectors/raw/4cc0ea22561541dddd22c32dc83347f5a376c909/external-import%2Fdark-web-informer%2Fsrc%2Fconnector%2Fstate.py","contents_url":"https://api.github.com/repos/OpenCTI-Platform/connectors/contents/external-import%2Fdark-web-informer%2Fsrc%2Fconnector%2Fstate.py?ref=4cc0ea22561541dddd22c32dc83347f5a376c909","patch":"@@ -0,0 +1,26 @@\n+\"\"\"Connector persisted state.\n+\n+OpenCTI stores this state between runs. It lets the connector forward only\n+the objects Dark Web Informer changed since the previous run, instead of\n+re-importing the whole snapshot every time.\n+\"\"\"\n+\n+from datetime import datetime\n+\n+from connectors_sdk import ExternalImportConnectorState\n+from pydantic import Field\n+\n+\n+class ConnectorState(ExternalImportConnectorState):\n+    \"\"\"Checkpoints used to resume imports across connector runs.\n+\n+    Inherits the generic ``last_run`` timestamp from ``connectors-sdk``.\n+    \"\"\"\n+\n+    cursors: dict[str, datetime] | None = Field(\n+        default=None,\n+        description=(\n+            \"Per source, the most recent `modified`/`created` timestamp seen in \"\n+            \"the Dark Web Informer bundle during the last successful ingestion.\"\n+        ),\n+    )"},{"sha":"6d3e842317e49688f3bf0c48e28561e5938d5aae","filename":"external-import/dark-web-informer/tests/conftest.py","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/OpenCTI-Platform/connectors/blob/4cc0ea22561541dddd22c32dc83347f5a376c909/external-import%2Fdark-web-informer%2Ftests%2Fconftest.py","raw_url":"https://github.com/OpenCTI-Platform/connectors/raw/4cc0ea22561541dddd22c32dc83347f5a376c909/external-import%2Fdark-web-informer%2Ftests%2Fconftest.py","contents_url":"https://api.github.com/repos/OpenCTI-Platform/connectors/contents/external-import%2Fdark-web-informer%2Ftests%2Fconftest.py?ref=4cc0ea22561541dddd22c32dc83347f5a376c909","patch":"@@ -29,4 +29,5 @@ def helper():\n     mock = MagicMock()\n     mock.connect_id = \"d1c5e2a7-0b3f-4e8a-9c6d-7f2b1a4e9c30\"\n     mock.api.work.initiate_work.return_value = \"work-id\"\n+    mock.get_state.return_value = None\n     return mock"},{"sha":"aaba500571a709fb5cda33e6837a70d2d1eba8e0","filename":"external-import/dark-web-informer/tests/test_connector/test_connector.py","status":"modified","additions":265,"deletions":1,"changes":266,"blob_url":"https://github.com/OpenCTI-Platform/connectors/blob/4cc0ea22561541dddd22c32dc83347f5a376c909/external-import%2Fdark-web-informer%2Ftests%2Ftest_connector%2Ftest_connector.py","raw_url":"https://github.com/OpenCTI-Platform/connectors/raw/4cc0ea22561541dddd22c32dc83347f5a376c909/external-import%2Fdark-web-informer%2Ftests%2Ftest_connector%2Ftest_connector.py","contents_url":"https://api.github.com/repos/OpenCTI-Platform/connectors/contents/external-import%2Fdark-web-informer%2Ftests%2Ftest_connector%2Ftest_connector.py?ref=4cc0ea22561541dddd22c32dc83347f5a376c909","patch":"@@ -1,6 +1,7 @@\n \"\"\"Tests for the passthrough ingestion logic.\"\"\"\n \n import json\n+from datetime import datetime, timedelta, timezone\n from unittest.mock import MagicMock\n \n import pytest\n@@ -145,7 +146,7 @@ def test_process_message_records_last_run(connector):\n     connector.process_message()\n \n     state = connector.helper.set_state.call_args.args[0]\n-    assert \"last_run\" in state\n+    assert state[\"last_run\"] is not None\n \n \n def test_process_message_uses_preview_endpoint(connector):\n@@ -221,9 +222,272 @@ def test_process_message_initiates_work_only_once_across_sources(connector, help\n     assert helper.send_stix2_bundle.call_count == 2\n \n \n+TIMED_BUNDLE = {\n+    \"type\": \"bundle\",\n+    \"id\": \"bundle--1\",\n+    \"objects\": [\n+        {\n+            \"type\": \"indicator\",\n+            \"id\": \"indicator--old\",\n+            \"created\": \"2026-01-01T00:00:00.000Z\",\n+            \"modified\": \"2026-01-01T00:00:00.000Z\",\n+        },\n+        {\"type\": \"domain-name\", \"id\": \"domain-name--old\", \"value\": \"old.test\"},\n+        {\n+            \"type\": \"relationship\",\n+            \"id\": \"relationship--old\",\n+            \"modified\": \"2026-01-01T00:00:00Z\",\n+            \"source_ref\": \"indicator--old\",\n+            \"target_ref\": \"domain-name--old\",\n+        },\n+        {\n+            \"type\": \"indicator\",\n+            \"id\": \"indicator--new\",\n+            \"modified\": \"2026-03-01T12:00:00.123Z\",\n+            \"created_by_ref\": \"identity--dwi\",\n+        },\n+        {\"type\": \"identity\", \"id\": \"identity--dwi\", \"created\": \"2025-01-01T00:00:00Z\"},\n+        {\"type\": \"domain-name\", \"id\": \"domain-name--new\", \"value\": \"new.test\"},\n+        {\n+            \"type\": \"relationship\",\n+            \"id\": \"relationship--new\",\n+            \"modified\": \"2026-03-01T00:00:00Z\",\n+            \"source_ref\": \"indicator--new\",\n+            \"target_ref\": \"domain-name--new\",\n+        },\n+    ],\n+}\n+\n+\n+NEWEST = datetime(2026, 3, 1, 12, 0, 0, 123000, tzinfo=timezone.utc)\n+\n+\n+def _saved_cursors(helper):\n+    saved = helper.set_state.call_args.args[0][\"cursors\"]\n+    return {\n+        k: datetime.fromisoformat(v.replace(\"Z\", \"+00:00\")) for k, v in saved.items()\n+    }\n+\n+\n+def _sent_ids(helper):\n+    sent = json.loads(helper.send_stix2_bundle.call_args.args[0])\n+    return {o[\"id\"] for o in sent[\"objects\"]}\n+\n+\n+def test_first_run_sends_everything_and_stores_cursor(connector, helper):\n+    connector.sources = [\"feed\"]\n+    connector.client.get_stix_bundle.return_value = TIMED_BUNDLE\n+\n+    connector.process_message()\n+\n+    assert {o[\"id\"] for o in TIMED_BUNDLE[\"objects\"]} <= _sent_ids(helper)\n+    assert _saved_cursors(helper) == {\"feed\": NEWEST}\n+    assert helper.set_state.call_args.args[0][\"last_run\"] is not None\n+\n+\n+def test_next_run_only_sends_changed_objects_and_their_references(connector, helper):\n+    connector.sources = [\"feed\"]\n+    helper.get_state.return_value = {\"cursors\": {\"feed\": \"2026-02-01T00:00:00+00:00\"}}\n+    connector.client.get_stix_bundle.return_value = TIMED_BUNDLE\n+\n+    connector.process_message()\n+\n+    sent = _sent_ids(helper) - {\n+        connector.author_stix[\"id\"],\n+        connector.marking_stix[\"id\"],\n+    }\n+    assert sent == {\n+        \"indicator--new\",\n+        \"identity--dwi\",  # referenced through created_by_ref\n+        \"relationship--new\",\n+        \"domain-name--new\",  # timestamp-less SCO pulled in by the relationship\n+    }\n+\n+\n+def test_run_with_nothing_new_sends_nothing(connector, helper):\n+    connector.sources = [\"feed\"]\n+    helper.get_state.return_value = {\n+        \"cursors\": {\"feed\": \"2026-03-01T12:00:00.123000+00:00\"},\n+        \"last_run\": \"2026-03-01T13:00:00+00:00\",\n+    }\n+    connector.client.get_stix_bundle.return_value = TIMED_BUNDLE\n+\n+    connector.process_message()\n+\n+    helper.send_stix2_bundle.assert_not_called()\n+    helper.api.work.initiate_work.assert_not_called()\n+    assert _saved_cursors(helper) == {\"feed\": NEWEST}\n+\n+\n+def test_cursor_of_ingested_source_survives_later_failure(connector, helper):\n+    connector.sources = [\"feed\", \"iocs\"]\n+    connector.client.get_stix_bundle.side_effect = [\n+        TIMED_BUNDLE,\n+        RuntimeError(\"API down\"),\n+    ]\n+\n+    connector.process_message()\n+\n+    assert _saved_cursors(helper) == {\"feed\": NEWEST}\n+    assert helper.set_state.call_args.args[0][\"last_run\"] is None\n+\n+\n def test_run_schedules_process_message(connector, helper, settings):\n     connector.run()\n \n     kwargs = helper.schedule_iso.call_args.kwargs\n     assert kwargs[\"message_callback\"] == connector.process_message\n     assert kwargs[\"duration_period\"] == settings.connector.duration_period\n+\n+\n+def test_connector_state_starts_empty_and_is_json_serializable():\n+    from connector import ConnectorState\n+\n+    assert ConnectorState().last_run is None\n+    assert ConnectorState().cursors is None\n+    json.dumps(\n+        ConnectorState(last_run=NEWEST, cursors={\"feed\": NEWEST}).model_dump(\n+            mode=\"json\"\n+        )\n+    )\n+\n+\n+def test_provenance_reuses_dwi_author_so_there_is_a_single_creator(connector):\n+    bundle = {\n+        \"type\": \"bundle\",\n+        \"objects\": [\n+            {\n+                \"type\": \"identity\",\n+                \"id\": \"identity--dwi-own\",\n+                \"name\": \"DarkWebInformer\",\n+                \"identity_class\": \"organization\",\n+            },\n+            {\n+                \"type\": \"indicator\",\n+                \"id\": \"indicator--1\",\n+                \"created_by_ref\": \"identity--dwi-own\",\n+            },\n+            {\"type\": \"indicator\", \"id\": \"indicator--2\"},\n+            {\"type\": \"domain-name\", \"id\": \"domain-name--3\", \"value\": \"evil.test\"},\n+        ],\n+    }\n+\n+    sent = connector._with_provenance(bundle, bundle[\"objects\"])\n+    by_id = {o[\"id\"]: o for o in sent[\"objects\"]}\n+\n+    assert connector.author_stix[\"id\"] not in by_id\n+    identities = [o for o in sent[\"objects\"] if o[\"type\"] == \"identity\"]\n+    assert [i[\"id\"] for i in identities] == [\"identity--dwi-own\"]\n+    assert by_id[\"indicator--2\"][\"created_by_ref\"] == \"identity--dwi-own\"\n+    assert by_id[\"domain-name--3\"][\"x_opencti_created_by_ref\"] == \"identity--dwi-own\"\n+\n+\n+def test_changed_since_handles_odd_timestamps_and_list_refs(connector):\n+    cursor = datetime(2026, 2, 1, tzinfo=timezone.utc)\n+    objects = [\n+        {\n+            \"type\": \"report\",\n+            \"id\": \"report--new\",\n+            \"modified\": \"2026-03-01T00:00:00\",  # no timezone: read as UTC\n+            \"object_refs\": [\"indicator--ref\", 42],\n+        },\n+        {\"type\": \"indicator\", \"id\": \"indicator--ref\", \"modified\": \"not-a-date\"},\n+        {\"type\": \"indicator\", \"id\": \"indicator--unreferenced\", \"modified\": \"garbage\"},\n+    ]\n+\n+    kept = DarkWebInformerConnector._changed_since(objects, cursor)\n+\n+    assert [o[\"id\"] for o in kept] == [\"report--new\", \"indicator--ref\"]\n+\n+\n+def test_state_reset_from_opencti_triggers_full_import(connector, helper):\n+    connector.sources = [\"feed\"]\n+    connector.client.get_stix_bundle.return_value = TIMED_BUNDLE\n+    helper.get_state.return_value = {\"cursors\": {\"feed\": \"2026-02-01T00:00:00+00:00\"}}\n+    connector.process_message()\n+    assert \"indicator--old\" not in _sent_ids(helper)\n+\n+    # \"Reset state\" in OpenCTI: the stored state comes back empty\n+    helper.get_state.return_value = {}\n+    connector.process_message()\n+\n+    assert {o[\"id\"] for o in TIMED_BUNDLE[\"objects\"]} <= _sent_ids(helper)\n+\n+\n+def test_filtered_bundle_keeps_dwi_author_as_single_creator(connector, helper):\n+    connector.sources = [\"feed\"]\n+    helper.get_state.return_value = {\"cursors\": {\"feed\": \"2026-02-01T00:00:00+00:00\"}}\n+    connector.client.get_stix_bundle.return_value = {\n+        \"type\": \"bundle\",\n+        \"id\": \"bundle--1\",\n+        \"objects\": [\n+            {\n+                \"type\": \"identity\",\n+                \"id\": \"identity--dwi-own\",\n+                \"name\": \"DarkWebInformer\",\n+                \"identity_class\": \"organization\",\n+                \"created\": \"2025-01-01T00:00:00Z\",\n+            },\n+            {\n+                \"type\": \"indicator\",\n+                \"id\": \"indicator--old\",\n+                \"modified\": \"2026-01-01T00:00:00Z\",\n+                \"created_by_ref\": \"identity--dwi-own\",\n+            },\n+            # changed since the cursor, but declares no author\n+            {\n+                \"type\": \"indicator\",\n+                \"id\": \"indicator--new\",\n+                \"modified\": \"2026-03-01T00:00:00Z\",\n+            },\n+        ],\n+    }\n+\n+    connector.process_message()\n+\n+    sent = json.loads(helper.send_stix2_bundle.call_args.args[0])[\"objects\"]\n+    by_id = {o[\"id\"]: o for o in sent}\n+    assert [o[\"id\"] for o in sent if o[\"type\"] == \"identity\"] == [\"identity--dwi-own\"]\n+    assert by_id[\"indicator--new\"][\"created_by_ref\"] == \"identity--dwi-own\"\n+    assert \"indicator--old\" not in by_id\n+\n+\n+def test_future_dated_object_does_not_push_cursor_past_now(connector, helper):\n+    connector.sources = [\"feed\"]\n+    connector.client.get_stix_bundle.return_value = {\n+        \"type\": \"bundle\",\n+        \"id\": \"bundle--1\",\n+        \"objects\": [\n+            {\n+                \"type\": \"indicator\",\n+                \"id\": \"indicator--future\",\n+                \"modified\": \"2099-01-01T00:00:00Z\",\n+            }\n+        ],\n+    }\n+    connector.process_message()\n+\n+    saved = _saved_cursors(helper)[\"feed\"]\n+    assert saved <= datetime.now(timezone.utc)\n+\n+    # An object published right after the first run is still ingested\n+    helper.get_state.return_value = {\"cursors\": {\"feed\": saved.isoformat()}}\n+    connector.client.get_stix_bundle.return_value = {\n+        \"type\": \"bundle\",\n+        \"id\": \"bundle--2\",\n+        \"objects\": [\n+            {\n+                \"type\": \"indicator\",\n+                \"id\": \"indicator--future\",\n+                \"modified\": \"2099-01-01T00:00:00Z\",\n+            },\n+            {\n+                \"type\": \"indicator\",\n+                \"id\": \"indicator--new\",\n+                \"modified\": (saved + timedelta(seconds=1)).isoformat(),\n+            },\n+        ],\n+    }\n+    connector.process_message()\n+\n+    assert \"indicator--new\" in _sent_ids(helper)"}]}