{"sha":"02d8fb9784e8f14a1251e4c992cd82a5762417c6","node_id":"C_kwDOCUB6odoAKDAyZDhmYjk3ODRlOGYxNGExMjUxZTRjOTkyY2Q4MmE1NzYyNDE3YzY","commit":{"author":{"name":"Yih-Dar","email":"2521628+ydshieh@users.noreply.github.com","date":"2026-10-02T20:59:34Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-10-02T20:59:34Z"},"message":"[CI] check_bad_commit: use EFS cache to avoid Xet FUSE OOM (exit 137) (#49273)\n\n* [CI] check_bad_commit: use EFS cache to avoid Xet FUSE OOM (exit 137)\n\nTemporary workaround matching huggingface/transformers-ci#184: set\nHF_HOME=/mnt/efs_cache when the mount is present so pytest loads large\nmodel weights from EFS instead of Xet FUSE, avoiding the cgroup RAM\nexhaustion that kills the process with exit 137.\n\nCo-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>\n\n* simplify comment\n\nCo-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>\n\n---------\n\nCo-authored-by: ydshieh <ydshieh@users.noreply.github.com>\nCo-authored-by: Claude Sonnet 4.6 <noreply@anthropic.com>","tree":{"sha":"c8c8c2eca9b8aebcf8cd5b7f8007aff882efd0b4","url":"https://api.github.com/repos/huggingface/transformers/git/trees/c8c8c2eca9b8aebcf8cd5b7f8007aff882efd0b4"},"url":"https://api.github.com/repos/huggingface/transformers/git/commits/02d8fb9784e8f14a1251e4c992cd82a5762417c6","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqwBs2CRC1aQ7uu5UhlAAAW9oQAIcAU2iR67XPytjAhvAwUPAh\nqs2FaEsZASwbLgCFWpr0uOTabmY8GSpiKJDDx8dqOvzoa0WsOZA4fOtw3vt0INTs\nvK7zQwWGl9Z4MoKyCv2ff1nQmZRJ3lG0HmTJMQflMFp2vkC82fb3oSGugOZ0TRx8\nQbzmmuhKMZpVgxPE4vqmmuB2KoSqtS2q+8hPLjU7sZzskcj8lL98T2nidCbN/Px1\nN07YN6UGfKt/U3B/wMlrBmQyCN24nsxYMCvCTSySnHkya9dmCWO4vk71haFyOec9\n40eLx9UUyR0Y/tfxV795gmvO9ClGVd4WY4/MMHuN6xec2Kdd6QXLFuuQx4xoIpUS\njmSRsr6zphEO+4DywPRqfae4tbmzLeHztmkrs1BHhKlegCMxPCAcyNIxxoy39P4Z\nV4F/gHnPHJ+a3k8BlyPHqmkAafoXkAUYV8XjNC3kjY3GihZVm6eADEzyU5EilSw+\nxjVR9ZGdfKur6LNKqRarVdj7GMi1WI3t9OboYFrQacOgSRWVZSchsc5wWoXHqlk/\nLyg1Ic/24LOvi3CO/Bs2A6bvugS/HQxaQqmFki2bOceH+rJ0k/QLpr8xoW1g4YGD\nSIYrka4MlHmpI8asFAFiC7fxoh7cXeIAsETRfO1365pITtRf3xY/pgtN7j5LV2O+\nDNqhjmLmJeHQvaMUFsjz\n=LVRK\n-----END PGP SIGNATURE-----\n","payload":"tree c8c8c2eca9b8aebcf8cd5b7f8007aff882efd0b4\nparent 42adb294b8915462f9d97db6270fb6b29087a904\nauthor Yih-Dar <2521628+ydshieh@users.noreply.github.com> 1790974774 +0200\ncommitter GitHub <noreply@github.com> 1790974774 +0200\n\n[CI] check_bad_commit: use EFS cache to avoid Xet FUSE OOM (exit 137) (#49273)\n\n* [CI] check_bad_commit: use EFS cache to avoid Xet FUSE OOM (exit 137)\n\nTemporary workaround matching huggingface/transformers-ci#184: set\nHF_HOME=/mnt/efs_cache when the mount is present so pytest loads large\nmodel weights from EFS instead of Xet FUSE, avoiding the cgroup RAM\nexhaustion that kills the process with exit 137.\n\nCo-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>\n\n* simplify comment\n\nCo-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>\n\n---------\n\nCo-authored-by: ydshieh <ydshieh@users.noreply.github.com>\nCo-authored-by: Claude Sonnet 4.6 <noreply@anthropic.com>","verified_at":"2026-10-02T20:59:34Z"}},"url":"https://api.github.com/repos/huggingface/transformers/commits/02d8fb9784e8f14a1251e4c992cd82a5762417c6","html_url":"https://github.com/huggingface/transformers/commit/02d8fb9784e8f14a1251e4c992cd82a5762417c6","comments_url":"https://api.github.com/repos/huggingface/transformers/commits/02d8fb9784e8f14a1251e4c992cd82a5762417c6/comments","author":{"login":"ydshieh","id":2521628,"node_id":"MDQ6VXNlcjI1MjE2Mjg=","avatar_url":"https://avatars.githubusercontent.com/u/2521628?v=4","gravatar_id":"","url":"https://api.github.com/users/ydshieh","html_url":"https://github.com/ydshieh","followers_url":"https://api.github.com/users/ydshieh/followers","following_url":"https://api.github.com/users/ydshieh/following{/other_user}","gists_url":"https://api.github.com/users/ydshieh/gists{/gist_id}","starred_url":"https://api.github.com/users/ydshieh/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ydshieh/subscriptions","organizations_url":"https://api.github.com/users/ydshieh/orgs","repos_url":"https://api.github.com/users/ydshieh/repos","events_url":"https://api.github.com/users/ydshieh/events{/privacy}","received_events_url":"https://api.github.com/users/ydshieh/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"42adb294b8915462f9d97db6270fb6b29087a904","url":"https://api.github.com/repos/huggingface/transformers/commits/42adb294b8915462f9d97db6270fb6b29087a904","html_url":"https://github.com/huggingface/transformers/commit/42adb294b8915462f9d97db6270fb6b29087a904"}],"stats":{"total":6,"additions":6,"deletions":0},"files":[{"sha":"892923f96fa7cbd4530fa3e7ebb5721582051618","filename":"utils/check_bad_commit.py","status":"modified","additions":6,"deletions":0,"changes":6,"blob_url":"https://github.com/huggingface/transformers/blob/02d8fb9784e8f14a1251e4c992cd82a5762417c6/utils%2Fcheck_bad_commit.py","raw_url":"https://github.com/huggingface/transformers/raw/02d8fb9784e8f14a1251e4c992cd82a5762417c6/utils%2Fcheck_bad_commit.py","contents_url":"https://api.github.com/repos/huggingface/transformers/contents/utils%2Fcheck_bad_commit.py?ref=02d8fb9784e8f14a1251e4c992cd82a5762417c6","patch":"@@ -25,6 +25,12 @@\n from github_utils import get_github_json\n \n \n+# Temporary workaround similar to https://github.com/huggingface/transformers-ci/pull/184 to avoid CPU OOM.\n+if os.path.isdir(\"/mnt/efs_cache\"):\n+    os.environ[\"HF_HOME\"] = \"/mnt/efs_cache\"\n+    print(\"Using EFS cache: HF_HOME=/mnt/efs_cache\")\n+\n+\n def create_script(target_test, flake_runs=4):\n     \"\"\"Create a python script to be run by `git bisect run` to determine if `target_test` passes or fails.\n     If a test is not found in a commit, the script with exit code `0` (i.e. `Success`)."}]}