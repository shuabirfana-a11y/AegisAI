ithub.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"c28834df0093dbb7578f1978764dca92988832a8","url":"https://api.github.com/repos/vllm-project/vllm/commits/c28834df0093dbb7578f1978764dca92988832a8","html_url":"https://github.com/vllm-project/vllm/commit/c28834df0093dbb7578f1978764dca92988832a8"}],"stats":{"total":7,"additions":3,"deletions":4},"files":[{"sha":"c2b2b054a30ffdb7021e25b00279f5a1f0861ec8","filename":".buildkite/test_areas/models_basic.yaml","status":"modified","additions":3,"deletions":4,"changes":7,"blob_url":"https://github.com/vllm-project/vllm/blob/1a001d584244bd21829a5e5bd4a376ea141c0ce3/.buildkite%2Ftest_areas%2Fmodels_basic.yaml","raw_url":"https://github.com/vllm-project/vllm/raw/1a001d584244bd21829a5e5bd4a376ea141c0ce3/.buildkite%2Ftest_areas%2Fmodels_basic.yaml","contents_url":"https://api.github.com/repos/vllm-project/vllm/contents/.buildkite%2Ftest_areas%2Fmodels_basic.yaml?ref=1a001d584244bd21829a5e5bd4a376ea141c0ce3","patch":"@@ -124,10 +124,9 @@ steps:\n   - csrc/libtorch_stable/kimi_k3/\n   - tests/models/kimi_k3/\n   - tests/kernels/attention/test_kimi_k3_mla_fused_epilogue.py\n-  - tests/kernels/test_bf16_skinny_gemm.py\n   commands:\n     # The native NVIDIA Kimi K3 kernels require the SM100 family.\n-    - pytest -v -s models/kimi_k3 --ignore=models/kimi_k3/test_prefix_cache.py kernels/attention/test_kimi_k3_mla_fused_epilogue.py kernels/test_bf16_skinny_gemm.py\n+    - pytest -v -s models/kimi_k3 --ignore=models/kimi_k3/test_prefix_cache.py kernels/attention/test_kimi_k3_mla_fused_epilogue.py\n   mirror:\n     amd:\n       label: \":amd: (MI355) Kimi K3\"\n@@ -142,8 +141,8 @@ steps:\n       - vllm/platforms/rocm.py\n       commands:\n       # The ROCm KDA/AttnRes kernels are gated on gfx950, so this has to be MI355.\n-      # The two kernels/ files the NVIDIA job adds are CUDA-only (they import\n-      # cuda.bindings.driver), so they are deliberately left out here.\n+      # The kernels/ file the NVIDIA job adds is CUDA-only (it imports\n+      # cuda.bindings.driver), so it is deliberately left out here.\n       - pytest -v -s models/kimi_k3\n \n - label: \":nvidia: (4xB200) Kimi K3 Prefix Cache Shard %N\""}]}