low/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"8efb11cb7431f5c8287b662be71698f1bcedb213","url":"https://api.github.com/repos/triton-inference-server/server/commits/8efb11cb7431f5c8287b662be71698f1bcedb213","html_url":"https://github.com/triton-inference-server/server/commit/8efb11cb7431f5c8287b662be71698f1bcedb213"}],"stats":{"total":96,"additions":49,"deletions":47},"files":[{"sha":"51e3980bc49deab445731f485e49b2b58ae3ee6d","filename":"Dockerfile.sdk","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/triton-inference-server/server/blob/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/Dockerfile.sdk","raw_url":"https://github.com/triton-inference-server/server/raw/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/Dockerfile.sdk","contents_url":"https://api.github.com/repos/triton-inference-server/server/contents/Dockerfile.sdk?ref=eb74dea5d400b92f54eacbd5f3f84903c786e4cd","patch":"@@ -29,7 +29,7 @@\n #\n \n # Base image on the minimum Triton container\n-ARG BASE_IMAGE=nvcr.io/nvidia/tritonserver:26.08-py3-min\n+ARG BASE_IMAGE=nvcr.io/nvidia/tritonserver:26.09-py3-min\n \n ARG TRITON_CLIENT_REPO_SUBDIR=clientrepo\n ARG TRITON_REPO_ORGANIZATION=http://github.com/triton-inference-server"},{"sha":"ce27a7d6db1770e78d5c098cf9dd57bdae768e44","filename":"README.md","status":"modified","additions":5,"deletions":5,"changes":10,"blob_url":"https://github.com/triton-inference-server/server/blob/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/README.md","raw_url":"https://github.com/triton-inference-server/server/raw/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/README.md","contents_url":"https://api.github.com/repos/triton-inference-server/server/contents/README.md?ref=eb74dea5d400b92f54eacbd5f3f84903c786e4cd","patch":"@@ -29,8 +29,8 @@\n \n >[!WARNING]\n >You are currently on the `main` branch which tracks under-development progress\n->towards the next release. The current release is version [2.72.0](https://github.com/triton-inference-server/server/releases/latest)\n->and corresponds to the 26.08 container release on NVIDIA GPU Cloud (NGC).\n+>towards the next release. The current release is version [2.73.0](https://github.com/triton-inference-server/server/releases/latest)\n+>and corresponds to the 26.09 container release on NVIDIA GPU Cloud (NGC).\n \n # Triton Inference Server\n \n@@ -90,16 +90,16 @@ Inference Server with the\n \n ```bash\n # Step 1: Create the example model repository\n-git clone -b r26.08 https://github.com/triton-inference-server/server.git\n+git clone -b r26.09 https://github.com/triton-inference-server/server.git\n cd server/docs/examples\n ./fetch_models.sh\n \n # Step 2: Launch triton from the NGC Triton container\n-docker run --gpus=1 --rm --net=host -v ${PWD}/model_repository:/models nvcr.io/nvidia/tritonserver:26.08-py3 tritonserver --model-repository=/models --model-control-mode explicit --load-model densenet_onnx\n+docker run --gpus=1 --rm --net=host -v ${PWD}/model_repository:/models nvcr.io/nvidia/tritonserver:26.09-py3 tritonserver --model-repository=/models --model-control-mode explicit --load-model densenet_onnx\n \n # Step 3: Sending an Inference Request\n # In a separate console, launch the image_client example from the NGC Triton SDK container\n-docker run -it --rm --net=host nvcr.io/nvidia/tritonserver:26.08-py3-sdk /workspace/install/bin/image_client -m densenet_onnx -c 3 -s INCEPTION /workspace/images/mug.jpg\n+docker run -it --rm --net=host nvcr.io/nvidia/tritonserver:26.09-py3-sdk /workspace/install/bin/image_client -m densenet_onnx -c 3 -s INCEPTION /workspace/images/mug.jpg\n \n # Inference should return the following\n Image '/workspace/images/mug.jpg':"},{"sha":"4410b0e818b16a24a0aa7605802f1c85e1039aa3","filename":"build.py","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/triton-inference-server/server/blob/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/build.py","raw_url":"https://github.com/triton-inference-server/server/raw/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/build.py","contents_url":"https://api.github.com/repos/triton-inference-server/server/contents/build.py?ref=eb74dea5d400b92f54eacbd5f3f84903c786e4cd","patch":"@@ -74,7 +74,7 @@\n DEFAULT_TRITON_VERSION_MAP = {\n     \"release_version\": \"2.74.0dev\",\n     \"triton_container_version\": \"26.10dev\",\n-    \"upstream_container_version\": \"26.08\",\n+    \"upstream_container_version\": \"26.09\",\n     \"ort_version\": \"1.30.0\",\n     \"ort_openvino_version\": \"2026.3.1\",\n     \"standalone_openvino_version\": \"2026.3.1\","},{"sha":"b933d59619292e37b6c18b701fa09eb3193801ab","filename":"deploy/aws/values.yaml","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/triton-inference-server/server/blob/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/deploy%2Faws%2Fvalues.yaml","raw_url":"https://github.com/triton-inference-server/server/raw/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/deploy%2Faws%2Fvalues.yaml","contents_url":"https://api.github.com/repos/triton-inference-server/server/contents/deploy%2Faws%2Fvalues.yaml?ref=eb74dea5d400b92f54eacbd5f3f84903c786e4cd","patch":"@@ -27,7 +27,7 @@\n replicaCount: 1\n \n image:\n-  imageName: nvcr.io/nvidia/tritonserver:26.08-py3\n+  imageName: nvcr.io/nvidia/tritonserver:26.09-py3\n   pullPolicy: IfNotPresent\n   modelRepositoryPath: s3://triton-inference-server-repository/model_repository\n   numGpus: 1"},{"sha":"3d5387cceda5444919fa7426af451ec40252f9c2","filename":"deploy/fleetcommand/Chart.yaml","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/triton-inference-server/server/blob/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/deploy%2Ffleetcommand%2FChart.yaml","raw_url":"https://github.com/triton-inference-server/server/raw/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/deploy%2Ffleetcommand%2FChart.yaml","contents_url":"https://api.github.com/repos/triton-inference-server/server/contents/deploy%2Ffleetcommand%2FChart.yaml?ref=eb74dea5d400b92f54eacbd5f3f84903c786e4cd","patch":"@@ -26,7 +26,7 @@\n \n apiVersion: v1\n # appVersion is the Triton version; update when changing release\n-appVersion: 2.72.0\n+appVersion: 2.73.0\n description: Triton Inference Server (Fleet Command)\n name: triton-inference-server\n # version is the Chart version; update when changing anything in the chart"},{"sha":"067ddd75ba8eaf81abf6f3d388dfa9ee63acc103","filename":"deploy/fleetcommand/values.yaml","status":"modified","additions":3,"deletions":3,"changes":6,"blob_url":"https://github.com/triton-inference-server/server/blob/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/deploy%2Ffleetcommand%2Fvalues.yaml","raw_url":"https://github.com/triton-inference-server/server/raw/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/deploy%2Ffleetcommand%2Fvalues.yaml","contents_url":"https://api.github.com/repos/triton-inference-server/server/contents/deploy%2Ffleetcommand%2Fvalues.yaml?ref=eb74dea5d400b92f54eacbd5f3f84903c786e4cd","patch":"@@ -27,7 +27,7 @@\n replicaCount: 1\n \n image:\n-  imageName: nvcr.io/nvidia/tritonserver:26.08-py3\n+  imageName: nvcr.io/nvidia/tritonserver:26.09-py3\n   pullPolicy: IfNotPresent\n   numGpus: 1\n   serverCommand: tritonserver\n@@ -47,13 +47,13 @@ image:\n     #\n     # To set model control mode, uncomment and configure below\n     # TODO: Fix the following url, it is invalid\n-    # See https://github.com/triton-inference-server/server/blob/r26.08/docs/user_guide/model_management.md\n+    # See https://github.com/triton-inference-server/server/blob/r26.09/docs/user_guide/model_management.md\n     #  for more details\n     #- --model-control-mode=explicit|poll|none\n     #\n     # Additional server args\n     #\n-    # see https://github.com/triton-inference-server/server/blob/r26.08/README.md\n+    # see https://github.com/triton-inference-server/server/blob/r26.09/README.md\n     #  for more details\n \n service:"},{"sha":"06de8c87d32554f154e1b9452e372670d004e98d","filename":"deploy/gcp/values.yaml","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/triton-inference-server/server/blob/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/deploy%2Fgcp%2Fvalues.yaml","raw_url":"https://github.com/triton-inference-server/server/raw/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/deploy%2Fgcp%2Fvalues.yaml","contents_url":"https://api.github.com/repos/triton-inference-server/server/contents/deploy%2Fgcp%2Fvalues.yaml?ref=eb74dea5d400b92f54eacbd5f3f84903c786e4cd","patch":"@@ -27,7 +27,7 @@\n replicaCount: 1\n \n image:\n-  imageName: nvcr.io/nvidia/tritonserver:26.08-py3\n+  imageName: nvcr.io/nvidia/tritonserver:26.09-py3\n   pullPolicy: IfNotPresent\n   modelRepositoryPath: gs://triton-inference-server-repository/model_repository\n   numGpus: 1"},{"sha":"5f0e360af29f3f444bb9f326db43d09f690fcdf6","filename":"deploy/gke-marketplace-app/benchmark/perf-analyzer-script/triton_client.yaml","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/triton-inference-server/server/blob/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/deploy%2Fgke-marketplace-app%2Fbenchmark%2Fperf-analyzer-script%2Ftriton_client.yaml","raw_url":"https://github.com/triton-inference-server/server/raw/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/deploy%2Fgke-marketplace-app%2Fbenchmark%2Fperf-analyzer-script%2Ftriton_client.yaml","contents_url":"https://api.github.com/repos/triton-inference-server/server/contents/deploy%2Fgke-marketplace-app%2Fbenchmark%2Fperf-analyzer-script%2Ftriton_client.yaml?ref=eb74dea5d400b92f54eacbd5f3f84903c786e4cd","patch":"@@ -33,7 +33,7 @@ metadata:\n   namespace: default\n spec:\n   containers:\n-  - image: nvcr.io/nvidia/tritonserver:26.08-py3-sdk\n+  - image: nvcr.io/nvidia/tritonserver:26.09-py3-sdk\n     imagePullPolicy: Always\n     name: nv-triton-client\n     securityContext:"},{"sha":"c4721d5467f580cc0c2fedf8a61a8bff3ddd1516","filename":"deploy/gke-marketplace-app/server-deployer/build_and_push.sh","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/triton-inference-server/server/blob/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/deploy%2Fgke-marketplace-app%2Fserver-deployer%2Fbuild_and_push.sh","raw_url":"https://github.com/triton-inference-server/server/raw/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/deploy%2Fgke-marketplace-app%2Fserver-deployer%2Fbuild_and_push.sh","contents_url":"https://api.github.com/repos/triton-inference-server/server/contents/deploy%2Fgke-marketplace-app%2Fserver-deployer%2Fbuild_and_push.sh?ref=eb74dea5d400b92f54eacbd5f3f84903c786e4cd","patch":"@@ -28,8 +28,8 @@\n export REGISTRY=gcr.io/$(gcloud config get-value project | tr ':' '/')\n export APP_NAME=tritonserver\n export MAJOR_VERSION=2.67\n-export MINOR_VERSION=2.72.0\n-export NGC_VERSION=26.08-py3\n+export MINOR_VERSION=2.73.0\n+export NGC_VERSION=26.09-py3\n \n docker pull nvcr.io/nvidia/$APP_NAME:$NGC_VERSION\n "},{"sha":"cf874c05a371b263acd11ae6729bee46d4c89946","filename":"deploy/gke-marketplace-app/server-deployer/chart/triton/Chart.yaml","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/triton-inference-server/server/blob/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/deploy%2Fgke-marketplace-app%2Fserver-deployer%2Fchart%2Ftriton%2FChart.yaml","raw_url":"https://github.com/triton-inference-server/server/raw/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/deploy%2Fgke-marketplace-app%2Fserver-deployer%2Fchart%2Ftriton%2FChart.yaml","contents_url":"https://api.github.com/repos/triton-inference-server/server/contents/deploy%2Fgke-marketplace-app%2Fserver-deployer%2Fchart%2Ftriton%2FChart.yaml?ref=eb74dea5d400b92f54eacbd5f3f84903c786e4cd","patch":"@@ -28,4 +28,4 @@ apiVersion: v1\n appVersion: \"2.68\"\n description: Triton Inference Server\n name: triton-inference-server\n-version: 2.72.0\n+version: 2.73.0"},{"sha":"a30e0ebba8e19007f96dd9933d4da86ab9e310de","filename":"deploy/gke-marketplace-app/server-deployer/chart/triton/values.yaml","status":"modified","additions":3,"deletions":3,"changes":6,"blob_url":"https://github.com/triton-inference-server/server/blob/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/deploy%2Fgke-marketplace-app%2Fserver-deployer%2Fchart%2Ftriton%2Fvalues.yaml","raw_url":"https://github.com/triton-inference-server/server/raw/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/deploy%2Fgke-marketplace-app%2Fserver-deployer%2Fchart%2Ftriton%2Fvalues.yaml","contents_url":"https://api.github.com/repos/triton-inference-server/server/contents/deploy%2Fgke-marketplace-app%2Fserver-deployer%2Fchart%2Ftriton%2Fvalues.yaml?ref=eb74dea5d400b92f54eacbd5f3f84903c786e4cd","patch":"@@ -31,14 +31,14 @@ maxReplicaCount: 3\n tritonProtocol: HTTP\n # HPA GPU utilization autoscaling target\n HPATargetAverageValue: 85\n-modelRepositoryPath: gs://triton_sample_models/26.08\n-publishedVersion: '2.72.0'\n+modelRepositoryPath: gs://triton_sample_models/26.09\n+publishedVersion: '2.73.0'\n gcpMarketplace: true\n \n image:\n   registry: gcr.io\n   repository: nvidia-ngc-public/tritonserver\n-  tag: 26.08-py3\n+  tag: 26.09-py3\n   pullPolicy: IfNotPresent\n   # modify the model repository here to match your GCP storage bucket\n   numGpus: 1"},{"sha":"db0e67d244df24eb9b360c9b4c822bff320cbfab","filename":"deploy/gke-marketplace-app/server-deployer/data-test/schema.yaml","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/triton-inference-server/server/blob/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/deploy%2Fgke-marketplace-app%2Fserver-deployer%2Fdata-test%2Fschema.yaml","raw_url":"https://github.com/triton-inference-server/server/raw/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/deploy%2Fgke-marketplace-app%2Fserver-deployer%2Fdata-test%2Fschema.yaml","contents_url":"https://api.github.com/repos/triton-inference-server/server/contents/deploy%2Fgke-marketplace-app%2Fserver-deployer%2Fdata-test%2Fschema.yaml?ref=eb74dea5d400b92f54eacbd5f3f84903c786e4cd","patch":"@@ -27,7 +27,7 @@\n x-google-marketplace:\n   schemaVersion: v2\n   applicationApiVersion: v1beta1\n-  publishedVersion: '2.72.0'\n+  publishedVersion: '2.73.0'\n   publishedVersionMetadata:\n     releaseNote: >-\n       Initial release."},{"sha":"d29949116b9017ce1af07c94ad79d3ea943d2996","filename":"deploy/gke-marketplace-app/server-deployer/schema.yaml","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/triton-inference-server/server/blob/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/deploy%2Fgke-marketplace-app%2Fserver-deployer%2Fschema.yaml","raw_url":"https://github.com/triton-inference-server/server/raw/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/deploy%2Fgke-marketplace-app%2Fserver-deployer%2Fschema.yaml","contents_url":"https://api.github.com/repos/triton-inference-server/server/contents/deploy%2Fgke-marketplace-app%2Fserver-deployer%2Fschema.yaml?ref=eb74dea5d400b92f54eacbd5f3f84903c786e4cd","patch":"@@ -27,7 +27,7 @@\n x-google-marketplace:\n   schemaVersion: v2\n   applicationApiVersion: v1beta1\n-  publishedVersion: '2.72.0'\n+  publishedVersion: '2.73.0'\n   publishedVersionMetadata:\n     releaseNote: >-\n       Initial release.\n@@ -89,7 +89,7 @@ properties:\n   modelRepositoryPath:\n     type: string\n     title: Bucket where models are stored. Please make sure the user/service account to create the GKE app has permission to this GCS bucket. Read Triton documentation on configs and formatting details, supporting TensorRT, TensorFlow, Pytorch, Onnx ... etc.\n-    default: gs://triton_sample_models/26.08\n+    default: gs://triton_sample_models/26.09\n   image.ldPreloadPath:\n     type: string\n     title: Leave this empty by default. Triton allows users to create custom layers for backend such as TensorRT plugin, the compiled shared library must be provided via LD_PRELOAD environment variable."},{"sha":"a0349972ecef78922094d8f4dbe818b45e3be752","filename":"deploy/gke-marketplace-app/trt-engine/README.md","status":"modified","additions":3,"deletions":3,"changes":6,"blob_url":"https://github.com/triton-inference-server/server/blob/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/deploy%2Fgke-marketplace-app%2Ftrt-engine%2FREADME.md","raw_url":"https://github.com/triton-inference-server/server/raw/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/deploy%2Fgke-marketplace-app%2Ftrt-engine%2FREADME.md","contents_url":"https://api.github.com/repos/triton-inference-server/server/contents/deploy%2Fgke-marketplace-app%2Ftrt-engine%2FREADME.md?ref=eb74dea5d400b92f54eacbd5f3f84903c786e4cd","patch":"@@ -33,7 +33,7 @@\n ```\n docker run --gpus all -it --network host \\\n     --shm-size=1g --ulimit memlock=-1 --ulimit stack=67108864 \\\n-    -v ~:/scripts nvcr.io/nvidia/tensorrt:26.08-py3\n+    -v ~:/scripts nvcr.io/nvidia/tensorrt:26.09-py3\n \n pip install onnx six torch tf2onnx tensorflow\n \n@@ -57,7 +57,7 @@ mkdir -p engines\n \n python3 builder.py -m models/fine-tuned/bert_tf_ckpt_large_qa_squad2_amp_128_v19.03.1/model.ckpt -o engines/bert_large_int8_bs1_s128.engine -b 1 -s 128 -c models/fine-tuned/bert_tf_ckpt_large_qa_squad2_amp_128_v19.03.1/ -v models/fine-tuned/bert_tf_ckpt_large_qa_squad2_amp_128_v19.03.1/vocab.txt --int8 --fp16 --strict --calib-num 1 -iln -imh\n \n-gsutil cp bert_large_int8_bs1_s128.engine gs://triton_sample_models/26.08/bert/1/model.plan\n+gsutil cp bert_large_int8_bs1_s128.engine gs://triton_sample_models/26.09/bert/1/model.plan\n ```\n \n-For each Triton upgrade, container version used to generate the model, and the model path in GCS `gs://triton_sample_models/26.08/` should be updated accordingly with the correct version.\n+For each Triton upgrade, container version used to generate the model, and the model path in GCS `gs://triton_sample_models/26.09/` should be updated accordingly with the correct version."},{"sha":"fdbb0cc714e095a8550c37b102900dcc6d59e8ad","filename":"deploy/k8s-onprem/values.yaml","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/triton-inference-server/server/blob/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/deploy%2Fk8s-onprem%2Fvalues.yaml","raw_url":"https://github.com/triton-inference-server/server/raw/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/deploy%2Fk8s-onprem%2Fvalues.yaml","contents_url":"https://api.github.com/repos/triton-inference-server/server/contents/deploy%2Fk8s-onprem%2Fvalues.yaml?ref=eb74dea5d400b92f54eacbd5f3f84903c786e4cd","patch":"@@ -30,7 +30,7 @@ tags:\n   openshift: false\n \n image:\n-  imageName: nvcr.io/nvidia/tritonserver:26.08-py3\n+  imageName: nvcr.io/nvidia/tritonserver:26.09-py3\n   pullPolicy: IfNotPresent\n   modelRepositoryServer: < Replace with the IP Address of your file server >\n   modelRepositoryPath: /srv/models"},{"sha":"54fc06631f14243a860ea89d3f717fc8f32cb42c","filename":"deploy/oci/values.yaml","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/triton-inference-server/server/blob/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/deploy%2Foci%2Fvalues.yaml","raw_url":"https://github.com/triton-inference-server/server/raw/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/deploy%2Foci%2Fvalues.yaml","contents_url":"https://api.github.com/repos/triton-inference-server/server/contents/deploy%2Foci%2Fvalues.yaml?ref=eb74dea5d400b92f54eacbd5f3f84903c786e4cd","patch":"@@ -27,7 +27,7 @@\n replicaCount: 1\n \n image:\n-  imageName: nvcr.io/nvidia/tritonserver:26.08-py3\n+  imageName: nvcr.io/nvidia/tritonserver:26.09-py3\n   pullPolicy: IfNotPresent\n   modelRepositoryPath: s3://https://<OCI_NAMESPACE>.compat.objectstorage.<OCI_REGION>.oraclecloud.com:443/triton-inference-server-repository\n   numGpus: 1"},{"sha":"8c241843f9717c6148f6865c7a38fc2ccecf749e","filename":"docs/customization_guide/compose.md","status":"modified","additions":9,"deletions":9,"changes":18,"blob_url":"https://github.com/triton-inference-server/server/blob/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/docs%2Fcustomization_guide%2Fcompose.md","raw_url":"https://github.com/triton-inference-server/server/raw/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/docs%2Fcustomization_guide%2Fcompose.md","contents_url":"https://api.github.com/repos/triton-inference-server/server/contents/docs%2Fcustomization_guide%2Fcompose.md?ref=eb74dea5d400b92f54eacbd5f3f84903c786e4cd","patch":"@@ -46,8 +46,8 @@ The `compose.py` script can be found in the\n Simply clone the repository and run `compose.py` to create a custom container.\n Note: Created container version will depend on the branch that was cloned.\n For example branch\n- [r26.08](https://github.com/triton-inference-server/server/tree/r26.08)\n-should be used to create a image based on the NGC 26.08 Triton release.\n+ [r26.09](https://github.com/triton-inference-server/server/tree/r26.09)\n+should be used to create a image based on the NGC 26.09 Triton release.\n \n `compose.py` provides `--backend`, `--repoagent` options that allow you to\n specify which backends and repository agents to include in the custom image.\n@@ -78,20 +78,20 @@ For example, running\n ```\n python3 compose.py --backend pytorch --repoagent checksum\n ```\n-on branch [r26.08](https://github.com/triton-inference-server/server/tree/r26.08) pulls:\n-- `min` container `nvcr.io/nvidia/tritonserver:26.08-py3-min`\n-- `full` container `nvcr.io/nvidia/tritonserver:26.08-py3`\n+on branch [r26.09](https://github.com/triton-inference-server/server/tree/r26.09) pulls:\n+- `min` container `nvcr.io/nvidia/tritonserver:26.09-py3-min`\n+- `full` container `nvcr.io/nvidia/tritonserver:26.09-py3`\n \n Alternatively, users can specify the version of Triton container to pull from\n any branch by either:\n 1. Adding flag `--container-version <container version>` to branch\n ```\n-python3 compose.py --backend pytorch --repoagent checksum --container-version 26.08\n+python3 compose.py --backend pytorch --repoagent checksum --container-version 26.09\n ```\n 2. Specifying `--image min,<min container image name> --image full,<full container image name>`.\n    The user is responsible for specifying compatible `min` and `full` containers.\n ```\n-python3 compose.py --backend pytorch --repoagent checksum --image min,nvcr.io/nvidia/tritonserver:26.08-py3-min --image full,nvcr.io/nvidia/tritonserver:26.08-py3\n+python3 compose.py --backend pytorch --repoagent checksum --image min,nvcr.io/nvidia/tritonserver:26.09-py3-min --image full,nvcr.io/nvidia/tritonserver:26.09-py3\n ```\n Method 1 and 2 will result in the same composed container. Furthermore,\n `--image` flag overrides the `--container-version` flag when both are specified.\n@@ -102,8 +102,8 @@ Note:\n 2. vLLM and TensorRT-LLM backends are currently not supported backends for\n `compose.py`. If you want to build additional backends on top of these backends,\n it would be better to [build it yourself](#build-it-yourself) by using\n-`nvcr.io/nvidia/tritonserver:26.08-vllm-python-py3` or\n-`nvcr.io/nvidia/tritonserver:26.08-trtllm-python-py3` as a `min` container.\n+`nvcr.io/nvidia/tritonserver:26.09-vllm-python-py3` or\n+`nvcr.io/nvidia/tritonserver:26.09-trtllm-python-py3` as a `min` container.\n \n \n ### CPU-only container composition"},{"sha":"c467e6c7c6039c8c43bb07d1b578deec35cb6f4e","filename":"docs/getting_started/llm.md","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/triton-inference-server/server/blob/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/docs%2Fgetting_started%2Fllm.md","raw_url":"https://github.com/triton-inference-server/server/raw/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/docs%2Fgetting_started%2Fllm.md","contents_url":"https://api.github.com/repos/triton-inference-server/server/contents/docs%2Fgetting_started%2Fllm.md?ref=eb74dea5d400b92f54eacbd5f3f84903c786e4cd","patch":"@@ -55,7 +55,7 @@ as the example model.\n ### 1. Launch the container\n \n ```bash\n-export RELEASE=26.08\n+export RELEASE=26.09\n docker run --rm -it --net host --shm-size=2g --ulimit memlock=-1 --gpus all \\\n     -v ~/.cache/huggingface:/root/.cache/huggingface \\\n     nvcr.io/nvidia/tritonserver:${RELEASE}-trtllm-python-py3 bash"},{"sha":"ba25c5c045213699f1fae63ffe0c209754e21c31","filename":"docs/introduction/compatibility.md","status":"modified","additions":2,"deletions":0,"changes":2,"blob_url":"https://github.com/triton-inference-server/server/blob/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/docs%2Fintroduction%2Fcompatibility.md","raw_url":"https://github.com/triton-inference-server/server/raw/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/docs%2Fintroduction%2Fcompatibility.md","contents_url":"https://api.github.com/repos/triton-inference-server/server/contents/docs%2Fintroduction%2Fcompatibility.md?ref=eb74dea5d400b92f54eacbd5f3f84903c786e4cd","patch":"@@ -71,6 +71,7 @@\n \n | Triton release version\t | NGC Tag\t | Python version\t | vLLM version | CUDA version | CUDA Driver version | Size |\n | --- | --- | --- | --- | --- | --- | --- |\n+| 26.09 | nvcr.io/nvidia/tritonserver:26.09-vllm-python-py3 | Python 3.12.3  | 0.29.0+3b480f30.nv26.9.68265578 | 13.4.1.012 | 615.71.09 | 10.57 GB |\n | 26.08 | nvcr.io/nvidia/tritonserver:26.08-vllm-python-py3 | Python 3.12.3  | 0.27.1+b1082979.nv26.8.62699174 | 13.4.1.012 | 615.61 | 10.65 GB |\n | 26.07 | nvcr.io/nvidia/tritonserver:26.07-vllm-python-py3 | Python 3.12.3  | 0.24.0+092c4842.nv26.7.57386851| 13.3.0.035 | 610.43.02 | 10.28 GB |\n | 26.06 | nvcr.io/nvidia/tritonserver:26.06-vllm-python-py3 | Python 3.12.3  | 0.22.1+7b9cb5b7.nv26.6.55098374 | 13.3.0.035 | 610.43.02 | 10.21 GB |\n@@ -105,6 +106,7 @@\n \n | Triton release version\t | ONNX Runtime\t |\n | --- | --- |\n+| 26.09 | 1.30.0 |\n | 26.08 | 1.28.0 |\n | 26.07 | 1.27.0 |\n | 26.06 | 1.24.4 |"},{"sha":"4d306d46e5ce35a4111f407074c432107a119c7f","filename":"docs/introduction/release_notes.md","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/triton-inference-server/server/blob/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/docs%2Fintroduction%2Frelease_notes.md","raw_url":"https://github.com/triton-inference-server/server/raw/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/docs%2Fintroduction%2Frelease_notes.md","contents_url":"https://api.github.com/repos/triton-inference-server/server/contents/docs%2Fintroduction%2Frelease_notes.md?ref=eb74dea5d400b92f54eacbd5f3f84903c786e4cd","patch":"@@ -25,9 +25,9 @@\n # (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE\n # OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n -->\n-# [Triton Inference Server Release 26.08](https://docs.nvidia.com/deeplearning/triton-inference-server/release-notes/rel-26-08.html#rel-26-08)\n+# [Triton Inference Server Release 26.09](https://docs.nvidia.com/deeplearning/triton-inference-server/release-notes/rel-26-08.html#rel-26-08)\n \n-The Triton Inference Server container image, release 26.08, is available\n+The Triton Inference Server container image, release 26.09, is available\n on [NGC](https://ngc.nvidia.com/catalog/containers/nvidia:tritonserver) and\n is open source\n on [GitHub](https://github.com/triton-inference-server/server). Release notes can"},{"sha":"5108f335d3593b137f7bfdfaea9605661ff6df6f","filename":"docs/user_guide/performance_tuning.md","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/triton-inference-server/server/blob/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/docs%2Fuser_guide%2Fperformance_tuning.md","raw_url":"https://github.com/triton-inference-server/server/raw/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/docs%2Fuser_guide%2Fperformance_tuning.md","contents_url":"https://api.github.com/repos/triton-inference-server/server/contents/docs%2Fuser_guide%2Fperformance_tuning.md?ref=eb74dea5d400b92f54eacbd5f3f84903c786e4cd","patch":"@@ -235,7 +235,7 @@ with a `tritonserver` binary.\n \n ```bash\n # Start server container\n-docker run -ti --rm --gpus=all --network=host -v $PWD:/mnt --name triton-server nvcr.io/nvidia/tritonserver:26.08-py3\n+docker run -ti --rm --gpus=all --network=host -v $PWD:/mnt --name triton-server nvcr.io/nvidia/tritonserver:26.09-py3\n \n # Start serving your models\n tritonserver --model-repository=/mnt/models\n@@ -284,7 +284,7 @@ by setting the `-u` flag, such as `perf_analyzer -m densenet_onnx -u\n \n ```bash\n # Start the SDK container interactively\n-docker run -ti --rm --gpus=all --network=host -v $PWD:/mnt --name triton-client nvcr.io/nvidia/tritonserver:26.08-py3-sdk\n+docker run -ti --rm --gpus=all --network=host -v $PWD:/mnt --name triton-client nvcr.io/nvidia/tritonserver:26.09-py3-sdk\n \n # Benchmark model being served from step 3\n perf_analyzer -m densenet_onnx --concurrency-range 1:4"},{"sha":"765c8e3ed2e9658f1c19e6ae636abf294a7d401b","filename":"python/openai/README.md","status":"modified","additions":3,"deletions":3,"changes":6,"blob_url":"https://github.com/triton-inference-server/server/blob/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/python%2Fopenai%2FREADME.md","raw_url":"https://github.com/triton-inference-server/server/raw/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/python%2Fopenai%2FREADME.md","contents_url":"https://api.github.com/repos/triton-inference-server/server/contents/python%2Fopenai%2FREADME.md?ref=eb74dea5d400b92f54eacbd5f3f84903c786e4cd","patch":"@@ -46,7 +46,7 @@\n docker run -it --net=host --gpus all --rm \\\n   -v ${HOME}/.cache/huggingface:/root/.cache/huggingface \\\n   -e HF_TOKEN \\\n-  nvcr.io/nvidia/tritonserver:26.08-vllm-python-py3\n+  nvcr.io/nvidia/tritonserver:26.09-vllm-python-py3\n ```\n \n 2. Launch the OpenAI-compatible Triton Inference Server:\n@@ -355,7 +355,7 @@ Currently, OpenAI-Compatible Frontend supports loading embedding models and embe\n docker run -it --net=host --gpus all --rm \\\n   -v ${HOME}/.cache/huggingface:/root/.cache/huggingface \\\n   -e HF_TOKEN \\\n-  nvcr.io/nvidia/tritonserver:26.08-vllm-python-py3\n+  nvcr.io/nvidia/tritonserver:26.09-vllm-python-py3\n ```\n \n 2. Launch the OpenAI-compatible Triton Inference Server:\n@@ -451,7 +451,7 @@ docker run -it --net=host --gpus all --rm \\\n   -v ${HOME}/.cache/huggingface:/root/.cache/huggingface \\\n   -e HF_TOKEN \\\n   -e TRTLLM_ORCHESTRATOR=1 \\\n-  nvcr.io/nvidia/tritonserver:26.08-trtllm-python-py3\n+  nvcr.io/nvidia/tritonserver:26.09-trtllm-python-py3\n ```\n \n 2. Install dependencies inside the container:"},{"sha":"9e3e25f37827ee99679a2ea58c7c30a353152af4","filename":"qa/L2_build_presets/README.md","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/triton-inference-server/server/blob/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/qa%2FL2_build_presets%2FREADME.md","raw_url":"https://github.com/triton-inference-server/server/raw/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/qa%2FL2_build_presets%2FREADME.md","contents_url":"https://api.github.com/repos/triton-inference-server/server/contents/qa%2FL2_build_presets%2FREADME.md?ref=eb74dea5d400b92f54eacbd5f3f84903c786e4cd","patch":"@@ -59,7 +59,7 @@ cd server/\n docker run --rm -v \"$PWD\":/workspace -w /workspace \\\n   -e TRITON_SERVER_BRANCH_NAME=<remote-branch> \\\n   -w /workspace/qa/L2_build_presets \\\n-  nvcr.io/nvidia/tritonserver:26.08-py3 python3 build_presets_test.py\n+  nvcr.io/nvidia/tritonserver:26.09-py3 python3 build_presets_test.py\n ```\n \n ## Output"},{"sha":"5fc5e6448d3989875347bb055c32d8051879601e","filename":"qa/common/gen_qa_model_repository","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/triton-inference-server/server/blob/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/qa%2Fcommon%2Fgen_qa_model_repository","raw_url":"https://github.com/triton-inference-server/server/raw/eb74dea5d400b92f54eacbd5f3f84903c786e4cd/qa%2Fcommon%2Fgen_qa_model_repository","contents_url":"https://api.github.com/repos/triton-inference-server/server/contents/qa%2Fcommon%2Fgen_qa_model_repository?ref=eb74dea5d400b92f54eacbd5f3f84903c786e4cd","patch":"@@ -72,7 +72,7 @@ log_message.status \"define: default values\"\n # named the container train here and the semver in CI, so reading it was wrong\n # half the time.\n TRITON_CONTAINER_VERSION=${TRITON_CONTAINER_VERSION:=26.09dev}\n-NVIDIA_UPSTREAM_VERSION=${NVIDIA_UPSTREAM_VERSION:=26.08}\n+NVIDIA_UPSTREAM_VERSION=${NVIDIA_UPSTREAM_VERSION:=26.09}\n TRITON_SEMVER=${TRITON_SEMVER:=2.73.0dev}\n ONNX_VERSION=1.22.0 # https://github.com/microsoft/onnxruntime/blob/v1.28.0/tools/ci_build/github/linux/python/requirements.txt#L15\n # Max opset ONNX Runtime accepts: the last *released* opset of the onnx that ORT"}]}