low/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"ac33965aaadfecf4f9b612cfbbd51a4ffdca590e","url":"https://api.github.com/repos/oasis-open/cti-python-stix2/commits/ac33965aaadfecf4f9b612cfbbd51a4ffdca590e","html_url":"https://github.com/oasis-open/cti-python-stix2/commit/ac33965aaadfecf4f9b612cfbbd51a4ffdca590e"},{"sha":"3b728839a0b7a838abb765d13c2cda50f50bc29f","url":"https://api.github.com/repos/oasis-open/cti-python-stix2/commits/3b728839a0b7a838abb765d13c2cda50f50bc29f","html_url":"https://github.com/oasis-open/cti-python-stix2/commit/3b728839a0b7a838abb765d13c2cda50f50bc29f"}],"stats":{"total":58,"additions":30,"deletions":28},"files":[{"sha":"dc4b9a232782f1abadd1c26f7588e52d6b4ed526","filename":".github/workflows/python-ci-tests.yml","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/oasis-open/cti-python-stix2/blob/2270361774215de49717c1a6028a80c91075b400/.github%2Fworkflows%2Fpython-ci-tests.yml","raw_url":"https://github.com/oasis-open/cti-python-stix2/raw/2270361774215de49717c1a6028a80c91075b400/.github%2Fworkflows%2Fpython-ci-tests.yml","contents_url":"https://api.github.com/repos/oasis-open/cti-python-stix2/contents/.github%2Fworkflows%2Fpython-ci-tests.yml?ref=2270361774215de49717c1a6028a80c91075b400","patch":"@@ -9,7 +9,7 @@ jobs:\n     runs-on: ubuntu-latest\n     strategy:\n       matrix:\n-        python-version: [3.8, 3.9, '3.10', '3.11', '3.12']\n+        python-version: ['3.10', '3.11', '3.12', '3.13', '3.14']\n \n     name: Python ${{ matrix.python-version }} Build\n     steps:"},{"sha":"4c6a63d0721e14abd685dd86626c57439385d75b","filename":".pre-commit-config.yaml","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/oasis-open/cti-python-stix2/blob/2270361774215de49717c1a6028a80c91075b400/.pre-commit-config.yaml","raw_url":"https://github.com/oasis-open/cti-python-stix2/raw/2270361774215de49717c1a6028a80c91075b400/.pre-commit-config.yaml","contents_url":"https://api.github.com/repos/oasis-open/cti-python-stix2/contents/.pre-commit-config.yaml?ref=2270361774215de49717c1a6028a80c91075b400","patch":"@@ -9,7 +9,7 @@ repos:\n     hooks:\n     -   id: add-trailing-comma\n -   repo: https://github.com/PyCQA/flake8\n-    rev: 3.8.4\n+    rev: 7.1.0\n     hooks:\n     -   id: flake8\n         name: Check project styling"},{"sha":"ae2bcfaf55685f85cecead75dc1b228f3f438d26","filename":"setup.cfg","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/oasis-open/cti-python-stix2/blob/2270361774215de49717c1a6028a80c91075b400/setup.cfg","raw_url":"https://github.com/oasis-open/cti-python-stix2/raw/2270361774215de49717c1a6028a80c91075b400/setup.cfg","contents_url":"https://api.github.com/repos/oasis-open/cti-python-stix2/contents/setup.cfg?ref=2270361774215de49717c1a6028a80c91075b400","patch":"@@ -1,5 +1,5 @@\n [bumpversion]\n-current_version = 3.0.1\n+current_version = 3.0.2\n commit = True\n tag = True\n "},{"sha":"d6a9cd0df0ce4813e5a3e01544676a2a79967510","filename":"setup.py","status":"modified","additions":4,"deletions":4,"changes":8,"blob_url":"https://github.com/oasis-open/cti-python-stix2/blob/2270361774215de49717c1a6028a80c91075b400/setup.py","raw_url":"https://github.com/oasis-open/cti-python-stix2/raw/2270361774215de49717c1a6028a80c91075b400/setup.py","contents_url":"https://api.github.com/repos/oasis-open/cti-python-stix2/contents/setup.py?ref=2270361774215de49717c1a6028a80c91075b400","patch":"@@ -38,20 +38,20 @@ def get_long_description():\n         'Topic :: Security',\n         'License :: OSI Approved :: BSD License',\n         'Programming Language :: Python :: 3',\n-        'Programming Language :: Python :: 3.8',\n-        'Programming Language :: Python :: 3.9',\n         'Programming Language :: Python :: 3.10',\n         'Programming Language :: Python :: 3.11',\n         'Programming Language :: Python :: 3.12',\n+        'Programming Language :: Python :: 3.13',\n+        'Programming Language :: Python :: 3.14',\n     ],\n     keywords='stix stix2 json cti cyber threat intelligence',\n     packages=find_packages(exclude=['*.test', '*.test.*']),\n-    python_requires='>=3.8',\n+    python_requires='>=3.10',\n     install_requires=[\n         'pytz',\n         'requests',\n         'simplejson',\n-        'stix2-patterns>=1.2.0',\n+        'stix2-patterns>=2.1.2',\n     ],\n     project_urls={\n         'Documentation': 'https://stix2.readthedocs.io/',"},{"sha":"04d718915b53df70430d1cd75273191f2fea910d","filename":"stix2/test/v20/test_pattern_equivalence.py","status":"modified","additions":8,"deletions":8,"changes":16,"blob_url":"https://github.com/oasis-open/cti-python-stix2/blob/2270361774215de49717c1a6028a80c91075b400/stix2%2Ftest%2Fv20%2Ftest_pattern_equivalence.py","raw_url":"https://github.com/oasis-open/cti-python-stix2/raw/2270361774215de49717c1a6028a80c91075b400/stix2%2Ftest%2Fv20%2Ftest_pattern_equivalence.py","contents_url":"https://api.github.com/repos/oasis-open/cti-python-stix2/contents/stix2%2Ftest%2Fv20%2Ftest_pattern_equivalence.py?ref=2270361774215de49717c1a6028a80c91075b400","patch":"@@ -10,12 +10,12 @@\n @pytest.mark.parametrize(\n     \"patt1, patt2\", [\n         (\n-            \"[a:b=1] START '1993-06-29T15:24:42Z' STOP '2000-07-30T19:29:58Z'\",\n-            \"[a:b=1 OR (a:c=2 AND a:b=1)] START '1993-06-29T15:24:42Z' STOP '2000-07-30T19:29:58Z'\",\n+            \"[a:b=1] START t'1993-06-29T15:24:42Z' STOP t'2000-07-30T19:29:58Z'\",\n+            \"[a:b=1 OR (a:c=2 AND a:b=1)] START t'1993-06-29T15:24:42Z' STOP t'2000-07-30T19:29:58Z'\",\n         ),\n         (\n-            \"[a:b=1] START '1993-06-29T15:24:42Z' STOP '2000-07-30T19:29:58Z' WITHIN 2 SECONDS\",\n-            \"[a:b=1 OR (a:c=2 AND a:b=1)] START '1993-06-29T15:24:42Z' STOP '2000-07-30T19:29:58Z' WITHIN 2 SECONDS\",\n+            \"[a:b=1] START t'1993-06-29T15:24:42Z' STOP t'2000-07-30T19:29:58Z' WITHIN 2 SECONDS\",\n+            \"[a:b=1 OR (a:c=2 AND a:b=1)] START t'1993-06-29T15:24:42Z' STOP t'2000-07-30T19:29:58Z' WITHIN 2 SECONDS\",\n         ),\n         (\n             \"[a:b=1] REPEATS 2 TIMES REPEATS 2 TIMES\",\n@@ -30,12 +30,12 @@ def test_startstop_equivalent(patt1, patt2):\n @pytest.mark.parametrize(\n     \"patt1, patt2\", [\n         (\n-            \"[a:b!=1] START '1993-06-29T15:24:42Z' STOP '2000-07-30T19:29:58Z'\",\n-            \"[a:b!=1] START '1977-09-29T07:41:03Z' STOP '1996-09-18T22:46:07Z'\",\n+            \"[a:b!=1] START t'1993-06-29T15:24:42Z' STOP t'2000-07-30T19:29:58Z'\",\n+            \"[a:b!=1] START t'1977-09-29T07:41:03Z' STOP t'1996-09-18T22:46:07Z'\",\n         ),\n         (\n-            \"[a:b<1] REPEATS 2 TIMES START '1993-06-29T15:24:42Z' STOP '2000-07-30T19:29:58Z'\",\n-            \"[a:b<1] REPEATS 2 TIMES START '1977-09-29T07:41:03Z' STOP '1996-09-18T22:46:07Z'\",\n+            \"[a:b<1] REPEATS 2 TIMES START t'1993-06-29T15:24:42Z' STOP t'2000-07-30T19:29:58Z'\",\n+            \"[a:b<1] REPEATS 2 TIMES START t'1977-09-29T07:41:03Z' STOP t'1996-09-18T22:46:07Z'\",\n         ),\n         (\n             \"[a:b=1] REPEATS 2 TIMES REPEATS 2 TIMES\","},{"sha":"624f1ae5f9358a015f84bd035a3de47d07f0959b","filename":"stix2/test/v20/test_pattern_expressions.py","status":"modified","additions":7,"deletions":6,"changes":13,"blob_url":"https://github.com/oasis-open/cti-python-stix2/blob/2270361774215de49717c1a6028a80c91075b400/stix2%2Ftest%2Fv20%2Ftest_pattern_expressions.py","raw_url":"https://github.com/oasis-open/cti-python-stix2/raw/2270361774215de49717c1a6028a80c91075b400/stix2%2Ftest%2Fv20%2Ftest_pattern_expressions.py","contents_url":"https://api.github.com/repos/oasis-open/cti-python-stix2/contents/stix2%2Ftest%2Fv20%2Ftest_pattern_expressions.py?ref=2270361774215de49717c1a6028a80c91075b400","patch":"@@ -2,6 +2,7 @@\n \n import pytest\n import pytz\n+from stix2patterns.exceptions import ParseException\n \n import stix2\n from stix2.pattern_visitor import create_pattern_object\n@@ -551,11 +552,11 @@ def test_parsing_qualified_expression():\n \n \n def test_parsing_start_stop_qualified_expression():\n-    patt_obj = create_pattern_object(\"[ipv4-addr:value = '1.2.3.4'] START '2016-06-01T00:00:00Z' STOP '2017-03-12T08:30:00Z'\", version=\"2.0\")\n+    patt_obj = create_pattern_object(\"[ipv4-addr:value = '1.2.3.4'] START t'2016-06-01T00:00:00Z' STOP t'2017-03-12T08:30:00Z'\", version=\"2.0\")\n \n     assert str(\n         patt_obj,\n-    ) == \"[ipv4-addr:value = '1.2.3.4'] START '2016-06-01T00:00:00Z' STOP '2017-03-12T08:30:00Z'\"\n+    ) == \"[ipv4-addr:value = '1.2.3.4'] START t'2016-06-01T00:00:00Z' STOP t'2017-03-12T08:30:00Z'\"\n \n \n def test_parsing_mixed_boolean_expression_1():\n@@ -585,8 +586,8 @@ def test_parsing_quoted_second_path_component():\n \n \n def test_parsing_illegal_start_stop_qualified_expression():\n-    with pytest.raises(ValueError):\n-        create_pattern_object(\"[ipv4-addr:value = '1.2.3.4'] START '2016-06-01' STOP '2017-03-12T08:30:00Z'\", version=\"2.0\")\n+    with pytest.raises(ParseException):\n+        create_pattern_object(\"[ipv4-addr:value = '1.2.3.4'] START t'2016-06-01' STOP t'2017-03-12T08:30:00Z'\", version=\"2.0\")\n \n \n def test_list_constant():\n@@ -631,7 +632,7 @@ def test_ast_class_override_string_constant():\n \n def test_ast_class_override_startstop_qualifier():\n     patt_ast = create_pattern_object(\n-        \"[a:b=1] START '1993-01-20T01:33:52.592Z' STOP '2001-08-19T23:50:23.129Z'\",\n+        \"[a:b=1] START t'1993-01-20T01:33:52.592Z' STOP t'2001-08-19T23:50:23.129Z'\",\n         \"Testing\", \"stix2.test.v20.pattern_ast_overrides\", version=\"2.0\",\n     )\n \n@@ -646,4 +647,4 @@ def test_ast_class_override_startstop_qualifier():\n     assert isinstance(\n         patt_ast.qualifier, StartStopQualifierForTesting,\n     )\n-    assert str(patt_ast) == \"[a:b = 1] START '1993-01-20T01:33:52.592Z' STOP '2001-08-19T23:50:23.129Z'\"\n+    assert str(patt_ast) == \"[a:b = 1] START t'1993-01-20T01:33:52.592Z' STOP t'2001-08-19T23:50:23.129Z'\""},{"sha":"5579627fe22cff85051f6b5166369d7218d816cf","filename":"stix2/test/v21/test_timestamp_precision.py","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/oasis-open/cti-python-stix2/blob/2270361774215de49717c1a6028a80c91075b400/stix2%2Ftest%2Fv21%2Ftest_timestamp_precision.py","raw_url":"https://github.com/oasis-open/cti-python-stix2/raw/2270361774215de49717c1a6028a80c91075b400/stix2%2Ftest%2Fv21%2Ftest_timestamp_precision.py","contents_url":"https://api.github.com/repos/oasis-open/cti-python-stix2/contents/stix2%2Ftest%2Fv21%2Ftest_timestamp_precision.py?ref=2270361774215de49717c1a6028a80c91075b400","patch":"@@ -9,7 +9,7 @@\n     parse_into_datetime, to_enum,\n )\n \n-_DT = datetime.datetime.utcnow()\n+_DT = datetime.datetime.now(datetime.timezone.utc)\n # intentionally omit microseconds from the following.  We add it in as\n # needed for each test.\n _DT_STR = _DT.strftime(\"%Y-%m-%dT%H:%M:%S\")\n@@ -55,7 +55,7 @@ def test_stix_datetime_now():\n \n \n def test_stix_datetime():\n-    dt = datetime.datetime.utcnow()\n+    dt = datetime.datetime.now(datetime.timezone.utc)\n \n     sdt = STIXdatetime(dt, precision=Precision.SECOND)\n     assert sdt.precision is Precision.SECOND"},{"sha":"cb1c8b954cbff270aa2aaf32699d8a08a1f793d8","filename":"stix2/version.py","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/oasis-open/cti-python-stix2/blob/2270361774215de49717c1a6028a80c91075b400/stix2%2Fversion.py","raw_url":"https://github.com/oasis-open/cti-python-stix2/raw/2270361774215de49717c1a6028a80c91075b400/stix2%2Fversion.py","contents_url":"https://api.github.com/repos/oasis-open/cti-python-stix2/contents/stix2%2Fversion.py?ref=2270361774215de49717c1a6028a80c91075b400","patch":"@@ -1,3 +1,3 @@\n-__version__ = \"3.0.1\"\n+__version__ = \"3.0.2\"\n \n DEFAULT_VERSION = '2.1'  # Default version will always be the latest STIX 2.X version"},{"sha":"d8ec9331231b3398da00dc07aac0a4a78e09fed3","filename":"tox.ini","status":"modified","additions":5,"deletions":4,"changes":9,"blob_url":"https://github.com/oasis-open/cti-python-stix2/blob/2270361774215de49717c1a6028a80c91075b400/tox.ini","raw_url":"https://github.com/oasis-open/cti-python-stix2/raw/2270361774215de49717c1a6028a80c91075b400/tox.ini","contents_url":"https://api.github.com/repos/oasis-open/cti-python-stix2/contents/tox.ini?ref=2270361774215de49717c1a6028a80c91075b400","patch":"@@ -1,5 +1,5 @@\n [tox]\n-envlist = py38,py39,py310,py311,py312,packaging,pre-commit-check\n+envlist = py310,py311,py312,py313,py314,packaging,pre-commit-check\n \n [testenv]\n deps =\n@@ -19,6 +19,7 @@ passenv = GITHUB_*\n [testenv:packaging]\n deps =\n   twine\n+  setuptools\n commands =\n   python setup.py sdist bdist_wheel --universal\n   twine check dist/*\n@@ -31,8 +32,8 @@ commands =\n \n [gh-actions]\n python =\n-  3.8: py38\n-  3.9: py39\n   3.10: py310\n-  3.11: py311, packaging, pre-commit-check\n+  3.11: py311\n   3.12: py312\n+  3.13: py313\n+  3.14: py314, packaging, pre-commit-check"}]}