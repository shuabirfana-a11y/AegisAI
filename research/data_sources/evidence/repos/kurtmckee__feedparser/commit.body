.py","contents_url":"https://api.github.com/repos/kurtmckee/feedparser/contents/feedparser%2F__init__.py?ref=a22c5521cbb109871f1a2318948581901bd47e26","patch":"@@ -36,10 +36,6 @@\n )\n from .util import FeedParserDict\n \n-__author__ = \"Kurt McKee <contactme@kurtmckee.org>\"\n-__license__ = \"BSD 2-clause\"\n-__version__ = \"6.0.14\"\n-\n # If you want feedparser to automatically resolve all relative URIs, set this\n # to 1.\n RESOLVE_RELATIVE_URIS = 1"},{"sha":"fae607984dbdf49e562e99ecf2699b29c704c3f0","filename":"pyproject.toml","status":"modified","additions":2,"deletions":1,"changes":3,"blob_url":"https://github.com/kurtmckee/feedparser/blob/a22c5521cbb109871f1a2318948581901bd47e26/pyproject.toml","raw_url":"https://github.com/kurtmckee/feedparser/raw/a22c5521cbb109871f1a2318948581901bd47e26/pyproject.toml","contents_url":"https://api.github.com/repos/kurtmckee/feedparser/contents/pyproject.toml?ref=a22c5521cbb109871f1a2318948581901bd47e26","patch":"@@ -1,6 +1,6 @@\n [project]\n name = \"feedparser\"\n-version = \"6.0.13\"\n+version = \"6.0.14\"\n description = \"Parse Atom/RSS/JSON feeds in Python\"\n readme = \"README.rst\"\n requires-python = \">=3.10\"\n@@ -94,6 +94,7 @@ filterwarnings = [\n [tool.scriv]\n version = \"literal: pyproject.toml: project.version\"\n categories = [\n+    \"Breaking changes\",\n     \"Python support\",\n     \"Added\",\n     \"Fixed\","}]}