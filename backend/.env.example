AEGIS_DATABASE_URL=postgresql+psycopg://aegis:CHANGE_ME@127.0.0.1:5432/aegis
AEGIS_HTTP_TIMEOUT=30
AEGIS_HTTP_RETRIES=3
AEGIS_REQUEST_INTERVAL=0.1
AEGIS_USER_AGENT=AegisAI/0.1 (bounded academic ingestion)
# Optional: AEGIS_GIT_BIN and AEGIS_CVE_CACHE for a new machine.
# No GitHub token is needed for the three current source adapters.
# Phase8 assets are closed unless a server-local token and owner are configured.
# AEGIS_ASSET_TOKEN=<set securely in your local environment; never commit>
# AEGIS_ASSET_OWNER=<server-controlled local principal>

# Phase 9-A: independent Model Gateway. Mock is synthetic, never benchmark evidence.
MODEL_PROVIDER=mock
MODEL_NAME=mock-text-v1
MODEL_EMBEDDING_PROVIDER=mock
MODEL_EMBEDDING_NAME=mock-embedding-v1
MODEL_EMBEDDING_DIMENSION=384
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_OUTPUT_TOKENS=1024
MODEL_STRUCTURED_MODE=prompt_json
MODEL_TOKEN_PARAMETER=max_tokens
# Optional real cached CPU embedding; no download and no migration of old entry points:
# MODEL_EMBEDDING_PROVIDER=local_embedding
# MODEL_EMBEDDING_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Remote compatible API requires explicit text/embedding model names and dimension:
# MODEL_PROVIDER=openai_compatible
# MODEL_API_BASE=https://model.example.invalid/v1
# MODEL_API_KEY=<set securely in your environment; never commit>
# MODEL_ALLOW_KEYLESS_LOCAL=false
# This example file is not loaded automatically by Model Gateway.
