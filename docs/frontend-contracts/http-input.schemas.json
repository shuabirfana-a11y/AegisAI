{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-contract-origin": "CURRENT_PYTHON_CODE",
  "x-http-exposed": true,
  "$defs": {
    "Decision": {
      "additionalProperties": false,
      "properties": {
        "expected_revision": {
          "minimum": 1,
          "title": "Expected Revision",
          "type": "integer"
        },
        "expected_claim_revision": {
          "minimum": 1,
          "title": "Expected Claim Revision",
          "type": "integer"
        },
        "request_key": {
          "maxLength": 150,
          "minLength": 1,
          "title": "Request Key",
          "type": "string"
        },
        "status": {
          "enum": [
            "CONFIRMED",
            "CONFLICT",
            "INSUFFICIENT_EVIDENCE",
            "PENDING",
            "REJECTED",
            "DEFERRED"
          ],
          "title": "Status",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "expected_revision",
        "expected_claim_revision",
        "request_key",
        "status",
        "reason",
        "evidence_ids"
      ],
      "title": "Decision",
      "type": "object"
    },
    "NewAsset": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "asset_type": {
          "default": "service",
          "enum": [
            "service",
            "training",
            "application",
            "project",
            "server",
            "container"
          ],
          "title": "Asset Type",
          "type": "string"
        },
        "environment": {
          "default": "unknown",
          "enum": [
            "production",
            "staging",
            "development",
            "unknown"
          ],
          "title": "Environment",
          "type": "string"
        },
        "exposure": {
          "default": "unknown",
          "enum": [
            "internet",
            "internal",
            "development",
            "unknown"
          ],
          "title": "Exposure",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "is_demo": {
          "default": false,
          "title": "Is Demo",
          "type": "boolean"
        },
        "request_key": {
          "maxLength": 150,
          "minLength": 1,
          "title": "Request Key",
          "type": "string"
        }
      },
      "required": [
        "name",
        "request_key"
      ],
      "title": "NewAsset",
      "type": "object"
    },
    "NewComponent": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "package_name": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Package Name"
        },
        "package_identifier_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Package Identifier Id"
        },
        "ecosystem": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ecosystem"
        },
        "namespace": {
          "default": "",
          "maxLength": 200,
          "title": "Namespace",
          "type": "string"
        },
        "purl": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Purl"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "source_ref": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Ref"
        },
        "request_key": {
          "maxLength": 150,
          "minLength": 1,
          "title": "Request Key",
          "type": "string"
        }
      },
      "required": [
        "name",
        "request_key"
      ],
      "title": "NewComponent",
      "type": "object"
    },
    "QueryRequest": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "asset_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Id"
        },
        "target": {
          "anyOf": [
            {
              "maxLength": 80,
              "pattern": "^(CVE-\\d{4}-\\d{4,}|[0-9a-fA-F]{8}-[0-9a-fA-F-]{27})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "mode": {
          "default": "auto",
          "enum": [
            "auto",
            "fast",
            "deep"
          ],
          "title": "Mode",
          "type": "string"
        },
        "request_key": {
          "maxLength": 150,
          "minLength": 1,
          "title": "Request Key",
          "type": "string"
        },
        "realtime": {
          "default": false,
          "title": "Realtime",
          "type": "boolean"
        }
      },
      "required": [
        "question",
        "request_key"
      ],
      "title": "QueryRequest",
      "type": "object"
    },
    "UpdateVersion": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "expected_revision": {
          "minimum": 1,
          "title": "Expected Revision",
          "type": "integer"
        },
        "request_key": {
          "maxLength": 150,
          "minLength": 1,
          "title": "Request Key",
          "type": "string"
        }
      },
      "required": [
        "expected_revision",
        "request_key"
      ],
      "title": "UpdateVersion",
      "type": "object"
    }
  },
  "x-roots": {
    "QueryRequest": {
      "$ref": "#/$defs/QueryRequest"
    },
    "Decision": {
      "$ref": "#/$defs/Decision"
    },
    "NewAsset": {
      "$ref": "#/$defs/NewAsset"
    },
    "NewComponent": {
      "$ref": "#/$defs/NewComponent"
    },
    "UpdateVersion": {
      "$ref": "#/$defs/UpdateVersion"
    }
  }
}
